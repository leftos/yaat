root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 150

[*.{yml,yaml,json}]
indent_size = 2

[*.{csproj,props,targets,slnx}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
indent_size = 4

# Rules below set to `suggestion` still have violations in the tree; each goes to `warning` in the commit that
# clears it (docs/plans/strict-formatting.md). The canonical file is the language-conventions skill's csharp/.editorconfig.

# Namespaces and usings
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:suggestion
dotnet_style_namespace_match_folder = true
dotnet_diagnostic.IDE0161.severity = warning
dotnet_diagnostic.IDE0130.severity = suggestion

# Braces are always required, even for single-statement bodies
csharp_prefer_braces = true:warning
dotnet_diagnostic.IDE0011.severity = warning

# var only when the type is apparent from the right-hand side
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_elsewhere = false:suggestion
dotnet_diagnostic.IDE0007.severity = warning
dotnet_diagnostic.IDE0008.severity = warning

# Modern language features
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
csharp_prefer_simple_using_statement = true:suggestion
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:suggestion
dotnet_style_readonly_field = true:suggestion
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_diagnostic.IDE0022.severity = warning
dotnet_diagnostic.IDE0290.severity = suggestion
dotnet_diagnostic.IDE0300.severity = suggestion
dotnet_diagnostic.IDE0301.severity = suggestion
dotnet_diagnostic.IDE0305.severity = suggestion
dotnet_diagnostic.ASP0027.severity = warning

# Naming: interfaces start with I, types and members are PascalCase
dotnet_naming_rule.interfaces_start_with_i.symbols = interface_symbols
dotnet_naming_rule.interfaces_start_with_i.style = i_prefixed
dotnet_naming_rule.interfaces_start_with_i.severity = warning
dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_style.i_prefixed.required_prefix = I
dotnet_naming_style.i_prefixed.capitalization = pascal_case

dotnet_naming_rule.types_are_pascal_case.symbols = type_symbols
dotnet_naming_rule.types_are_pascal_case.style = pascal_case
dotnet_naming_rule.types_are_pascal_case.severity = warning
dotnet_naming_symbols.type_symbols.applicable_kinds = class, struct, enum, delegate
dotnet_naming_style.pascal_case.capitalization = pascal_case

# --- Qodana suppression: false positives for this codebase ---

# DTO/serialization: properties accessed by JSON deserialization, not code
resharper_not_accessed_positional_property_global_highlighting = none
resharper_auto_property_can_be_made_get_only_global_highlighting = none
resharper_collection_never_updated_global_highlighting = none
resharper_property_can_be_made_init_only_global_highlighting = none
resharper_unused_auto_property_accessor_global_highlighting = none

# Cross-project / DI / framework: public APIs consumed by yaat-server
resharper_unused_member_global_highlighting = none
resharper_member_can_be_private_global_highlighting = none
resharper_class_never_instantiated_global_highlighting = none

# MVVM / Avalonia: CommunityToolkit.Mvvm partial methods, XAML bindings
resharper_unused_parameter_in_partial_method_highlighting = none
resharper_xaml_binding_with_context_not_resolved_highlighting = none

# Aviation acronyms (CIFP leg types: AF, CA, CF, etc.)
resharper_inconsistent_naming_highlighting = none

# Tests use explicit default values for readability
resharper_redundant_argument_default_value_highlighting = none

# ScenarioValidator SemaphoreSlim + Task.WhenAll pattern
resharper_access_to_disposed_closure_highlighting = none

# MVVM Toolkit: field initializers overwritten in constructor (OnXChanged pattern)
resharper_member_initializer_value_ignored_highlighting = none

[*.axaml]
# Avalonia XAML DataContext not statically resolvable
resharper_xaml_binding_with_context_not_resolved_highlighting = none
resharper_xaml_possible_null_reference_exception_highlighting = none
