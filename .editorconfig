root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 150

[*.{yml,yaml,json}]
indent_size = 2

[*.{csproj,props,targets,slnx}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
indent_size = 4

# Copied from the language-conventions skill's csharp/.editorconfig: change the convention there first.

# Namespaces and usings
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning
dotnet_style_namespace_match_folder = true
dotnet_diagnostic.IDE0161.severity = warning
dotnet_diagnostic.IDE0130.severity = warning
# Unused usings fail the build (needs GenerateDocumentationFile, set in Directory.Build.props)
dotnet_diagnostic.IDE0005.severity = warning

# Braces are always required, even for single-statement bodies
csharp_prefer_braces = true:warning
dotnet_diagnostic.IDE0011.severity = warning

# var only when the type is apparent from the right-hand side
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_elsewhere = false:warning
dotnet_diagnostic.IDE0007.severity = warning
dotnet_diagnostic.IDE0008.severity = warning

# Modern language features
csharp_style_expression_bodied_methods = when_on_single_line:warning
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_prefer_primary_constructors = true:warning
csharp_prefer_simple_using_statement = true:suggestion
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:suggestion
dotnet_style_readonly_field = true:suggestion
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
# A named tuple local keeps its name: deconstructing it turns the element names into locals and drops the meaning
csharp_style_deconstructed_variable_declaration = false
dotnet_diagnostic.IDE0022.severity = warning
dotnet_diagnostic.IDE0290.severity = warning
dotnet_diagnostic.IDE0300.severity = warning
dotnet_diagnostic.IDE0301.severity = warning
dotnet_diagnostic.IDE0305.severity = warning
dotnet_diagnostic.ASP0027.severity = warning

# Naming: interfaces start with I, types and members are PascalCase
dotnet_naming_rule.interfaces_start_with_i.symbols = interface_symbols
dotnet_naming_rule.interfaces_start_with_i.style = i_prefixed
dotnet_naming_rule.interfaces_start_with_i.severity = warning
dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_style.i_prefixed.required_prefix = I
dotnet_naming_style.i_prefixed.capitalization = pascal_case

dotnet_naming_rule.types_are_pascal_case.symbols = type_symbols
dotnet_naming_rule.types_are_pascal_case.style = pascal_case
dotnet_naming_rule.types_are_pascal_case.severity = warning
dotnet_naming_symbols.type_symbols.applicable_kinds = class, struct, enum, delegate
dotnet_naming_style.pascal_case.capitalization = pascal_case

# --- Qodana suppression: false positives for this codebase ---

# DTO/serialization: properties accessed by JSON deserialization, not code
resharper_not_accessed_positional_property_global_highlighting = none
resharper_auto_property_can_be_made_get_only_global_highlighting = none
resharper_collection_never_updated_global_highlighting = none
resharper_property_can_be_made_init_only_global_highlighting = none
resharper_unused_auto_property_accessor_global_highlighting = none

# Cross-project / DI / framework: public APIs consumed by yaat-server
resharper_unused_member_global_highlighting = none
resharper_member_can_be_private_global_highlighting = none
resharper_class_never_instantiated_global_highlighting = none

# MVVM / Avalonia: CommunityToolkit.Mvvm partial methods, XAML bindings
resharper_unused_parameter_in_partial_method_highlighting = none
resharper_xaml_binding_with_context_not_resolved_highlighting = none

# Aviation acronyms (CIFP leg types: AF, CA, CF, etc.)
resharper_inconsistent_naming_highlighting = none

# Tests use explicit default values for readability
resharper_redundant_argument_default_value_highlighting = none

# ScenarioValidator SemaphoreSlim + Task.WhenAll pattern
resharper_access_to_disposed_closure_highlighting = none

# MVVM Toolkit: field initializers overwritten in constructor (OnXChanged pattern)
resharper_member_initializer_value_ignored_highlighting = none

# AnalysisLevel latest-recommended raises these rules to warning. Each is held at suggestion until its YAAT-116
# part clears it and raises it back to warning.
dotnet_diagnostic.CA1000.severity = suggestion
dotnet_diagnostic.CA1001.severity = suggestion
dotnet_diagnostic.CA1036.severity = suggestion
dotnet_diagnostic.CA1050.severity = suggestion
dotnet_diagnostic.CA1305.severity = suggestion
dotnet_diagnostic.CA1310.severity = suggestion
dotnet_diagnostic.CA1711.severity = suggestion
dotnet_diagnostic.CA1716.severity = suggestion
dotnet_diagnostic.CA1720.severity = suggestion
dotnet_diagnostic.CA1725.severity = suggestion
dotnet_diagnostic.CA1805.severity = suggestion
dotnet_diagnostic.CA1806.severity = suggestion
dotnet_diagnostic.CA1816.severity = suggestion
dotnet_diagnostic.CA1836.severity = suggestion
dotnet_diagnostic.CA1844.severity = suggestion
dotnet_diagnostic.CA1847.severity = suggestion
dotnet_diagnostic.CA1848.severity = suggestion
dotnet_diagnostic.CA1852.severity = suggestion
dotnet_diagnostic.CA1854.severity = suggestion
dotnet_diagnostic.CA1862.severity = suggestion
dotnet_diagnostic.CA1865.severity = suggestion
dotnet_diagnostic.CA1866.severity = suggestion
dotnet_diagnostic.CA1869.severity = suggestion
dotnet_diagnostic.CA1872.severity = suggestion
dotnet_diagnostic.CA1875.severity = suggestion
dotnet_diagnostic.CA2016.severity = suggestion
dotnet_diagnostic.CA2101.severity = suggestion
dotnet_diagnostic.CA2201.severity = suggestion
dotnet_diagnostic.CA2249.severity = suggestion
dotnet_diagnostic.CA2263.severity = suggestion
dotnet_diagnostic.CA5351.severity = suggestion

# Raised to warning by their YAAT-116 part.
dotnet_diagnostic.CA1507.severity = warning
dotnet_diagnostic.CA1822.severity = warning
dotnet_diagnostic.CA1826.severity = warning
dotnet_diagnostic.CA1859.severity = warning
dotnet_diagnostic.CA1861.severity = warning
dotnet_diagnostic.SYSLIB1045.severity = warning
dotnet_diagnostic.SYSLIB1054.severity = warning

# Test method names use underscores (Method_Condition_Result).
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none

[*.axaml]
# Avalonia XAML DataContext not statically resolvable
resharper_xaml_binding_with_context_not_resolved_highlighting = none
resharper_xaml_possible_null_reference_exception_highlighting = none

[*.{bat,cmd}]
end_of_line = crlf

# build/sherpa/EnsureSherpaNatives.cs is compiled twice: in memory by RoslynCodeTaskFactory with no analyzers and no
# nullable context (that copy is the one the build runs), and linked into tests/Yaat.Client.Tests so that
# EnsureSherpaNativesTests drives the same source. The test project's style rules and nullable settings were not
# written for it, and rewriting the task to satisfy them would only make the two compiles differ.
[build/sherpa/EnsureSherpaNatives.cs]
dotnet_analyzer_diagnostic.severity = none
dotnet_diagnostic.CS8600.severity = none
dotnet_diagnostic.CS8603.severity = none
dotnet_diagnostic.CS8604.severity = none
dotnet_diagnostic.CS8618.severity = none
# Every rule the [*.cs] section pins individually, since a pinned rule outranks the blanket default above.
# IDE0005 too: the task compile has no implicit usings, so usings the test compile sees as unused are needed there.
dotnet_diagnostic.IDE0005.severity = none
dotnet_diagnostic.CA1507.severity = none
dotnet_diagnostic.CA1826.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.SYSLIB1045.severity = none
dotnet_diagnostic.IDE0007.severity = none
dotnet_diagnostic.IDE0008.severity = none
dotnet_diagnostic.IDE0011.severity = none
dotnet_diagnostic.IDE0022.severity = none
dotnet_diagnostic.IDE0130.severity = none
dotnet_diagnostic.IDE0161.severity = none
dotnet_diagnostic.IDE0290.severity = none
dotnet_diagnostic.IDE0300.severity = none
dotnet_diagnostic.IDE0301.severity = none
dotnet_diagnostic.IDE0305.severity = none
