<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The LibraryImport source generator emits unsafe marshalling code for ThreadCpuTime's OS entry points. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Yaat.Sim.Tests" />
    <InternalsVisibleTo Include="Yaat.Server" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Geo" Version="1.2.0" />
    <PackageReference Include="Google.Protobuf" Version="3.29.5" />
    <PackageReference Include="Grpc.Tools" Version="2.71.0" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Proto\nav_data.proto" GrpcServices="None" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Data\ARTCCs\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\ARTCCs\**\*.cifp">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\AircraftProfiles.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\AircraftProfileSiblings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\AircraftProfileOverrides.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\FacilityOps\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\aircraft-display-names.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\airline-fleets.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\airport-airlines.json.br">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\Airspace\*.geojson*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\Artcc\*.geojson*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\Mva\*.geojson*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\MilitaryRoutes\*.json*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Speech\Data\airlines.tsv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Speech\Data\aircraft-types.tsv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\PrecomputeCache\*.json.br">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\PrecomputeCache\design-group-envelopes.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The two source sets the precompute cache is keyed on: a change to either makes the entries computed from it stale.
    Both are globs, so a new source file joins the right set without an edit here. The layout set is every source under
    Data\Airport except the exclusions below, plus the sources outside it that those name; the push-target set is built
    on its own below and holds every layout source too, so its hash moves whenever the layout hash does.
  -->
  <ItemGroup>
    <!--
      Route-pathfinder and navigator-facing helpers that no layout-build source (GeoJsonParser, the fillet generator)
      and no tug-planner source (TugMovePlanner, TugPathCheck, TugTaxiwayClearance, MovementAreaClassification) reaches:
      rg on each type name across the files that stay in finds no reference from them. Keeping a file in costs a needless
      invalidation, excluding one that IS reached would bake a stale entry, so a doubtful file stays in. Precompute\ is
      excluded here because the layout set never holds the cache's own types.
    -->
    <PrecomputeLayoutExclude Include="Data\Airport\Precompute\**\*.cs" />
    <PrecomputeLayoutExclude Include="Data\Airport\AirportLayoutDownloader.cs" />
    <PrecomputeLayoutExclude Include="Data\Airport\GroundSpawnSnap.cs" />
    <PrecomputeLayoutExclude Include="Data\Airport\IAirportGroundData.cs" />
    <PrecomputeLayoutExclude Include="Data\Airport\LandingThreshold.cs" />
    <PrecomputeLayoutExclude Include="Data\Airport\RunwayCrossingEnd.cs" />
    <PrecomputeLayoutExclude Include="Data\Airport\RunwayEntryPoint.cs" />
    <PrecomputeLayoutExclude Include="Data\Airport\RunwayIntersectionCalculator.cs" />
    <PrecomputeLayoutExclude Include="Data\Airport\TaxiRouteAutoCross.cs" />
    <PrecomputeLayoutSource Include="Data\Airport\**\*.cs" Exclude="@(PrecomputeLayoutExclude)" />
    <PrecomputeLayoutSource Include="GeoMath.cs" />
    <!-- Named by layout sources (the footprint, design-group and ramp-lane code), so an edit to them stales the layout too. -->
    <PrecomputeLayoutSource Include="GroundOutline.cs" />
    <PrecomputeLayoutSource Include="GroundOutlineSweep.cs" />
    <PrecomputeLayoutSource Include="Data\Faa\AircraftLength.cs" />
    <PrecomputeLayoutSource Include="AircraftCategory.cs" />
    <!-- Named by layout sources too (node headings, the sidecar data the pathfinder and classifier read). -->
    <PrecomputeLayoutSource Include="TrueHeading.cs" />
    <PrecomputeLayoutSource Include="Data\AirportSidecarCatalog.cs" />
    <PrecomputeLayoutSource Include="Data\AirportSidecarDefinition.cs" />
    <PrecomputeLayoutSource Include="Data\AirportSidecarLoader.cs" />
    <!--
      The push-target set is built on its own: every source under Data\Airport (the tug planner and everything it can
      reach there) except the cache's own types, plus the cache types the push payload is computed and serialized
      through, the representatives file, and the geometry and aircraft-dimension sources outside Data\Airport the planner
      calls.
    -->
    <PrecomputePushTargetSource Include="Data\Airport\**\*.cs" Exclude="Data\Airport\Precompute\**\*.cs" />
    <PrecomputePushTargetSource Include="Data\Airport\Precompute\PrecomputeEntry.cs" />
    <PrecomputePushTargetSource Include="Data\Airport\Precompute\PushTargetEntry.cs" />
    <PrecomputePushTargetSource Include="Data\Airport\Precompute\PushMoveEntry.cs" />
    <PrecomputePushTargetSource Include="Data\Airport\Precompute\DesignGroupEnvelopes.cs" />
    <PrecomputePushTargetSource Include="Data\Airport\Precompute\PushTargetPlanner.cs" />
    <PrecomputePushTargetSource Include="Data\Airport\Precompute\AirportSidecarHash.cs" />
    <PrecomputePushTargetSource Include="GeoMath.cs" />
    <PrecomputePushTargetSource Include="GroundOutline.cs" />
    <PrecomputePushTargetSource Include="GroundOutlineSweep.cs" />
    <PrecomputePushTargetSource Include="Data\Faa\AircraftLength.cs" />
    <PrecomputePushTargetSource Include="AircraftCategory.cs" />
    <PrecomputePushTargetSource Include="TrueHeading.cs" />
    <PrecomputePushTargetSource Include="Data\AirportSidecarCatalog.cs" />
    <PrecomputePushTargetSource Include="Data\AirportSidecarDefinition.cs" />
    <PrecomputePushTargetSource Include="Data\AirportSidecarLoader.cs" />
    <PrecomputePushTargetSource Include="Data\PrecomputeCache\design-group-envelopes.json" />
  </ItemGroup>

  <!--
    PrecomputeSourceHashes.g.cs carries a SHA-256 per source set, so a stored precompute entry is recognised as stale.
    GetFileHash hashes each file; the WritePrecomputeSourceHashes inline task then sorts the project-relative paths
    (forward slashes, ordinal), concatenates the lowercase per-file hashes with no separator, and SHA-256s that ASCII
    string. The combination cannot be done with built-in tasks alone: WriteLinesToFile terminates every line with the
    platform newline, so a concatenation hashed through a temp file would differ between Windows and Linux.
  -->
  <UsingTask
    TaskName="WritePrecomputeSourceHashes"
    TaskFactory="RoslynCodeTaskFactory"
    AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll"
  >
    <ParameterGroup>
      <LayoutHashes ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <PushTargetHashes ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <OutputPath ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Security.Cryptography" />
      <Using Namespace="System.Text" />
      <Using Namespace="Microsoft.Build.Framework" />
      <Code Type="Fragment" Language="cs">
        ITaskItem[][] sets = new ITaskItem[][] { LayoutHashes, PushTargetHashes };
        string[] setHashes = new string[sets.Length];
        string[] setFileLists = new string[sets.Length];
        for (int s = 0; s != sets.Length; s++)
        {
          ITaskItem[] files = sets[s];
          string[] paths = new string[files.Length];
          string[] hashes = new string[files.Length];
          for (int i = 0; i != files.Length; i++)
          {
            paths[i] = files[i].ItemSpec.Replace('\\', '/');
            hashes[i] = files[i].GetMetadata("FileHash").ToLowerInvariant();
          }

          Array.Sort(paths, hashes, StringComparer.Ordinal);

          StringBuilder concatenated = new StringBuilder();
          foreach (string hash in hashes)
          {
            concatenated.Append(hash);
          }

          using (SHA256 sha = SHA256.Create())
          {
            byte[] concatenatedHash = sha.ComputeHash(Encoding.ASCII.GetBytes(concatenated.ToString()));
            setHashes[s] = BitConverter.ToString(concatenatedHash).Replace("-", "").ToLowerInvariant();
          }

          StringBuilder fileList = new StringBuilder();
          fileList.Append("    [\n");
          foreach (string path in paths)
          {
            fileList.Append("        \"").Append(path).Append("\",\n");
          }

          fileList.Append("    ]");
          setFileLists[s] = fileList.ToString();
        }

        StringBuilder source = new StringBuilder();
        source.Append("// &lt;auto-generated /&gt;\n");
        source.Append("// Generated by the GeneratePrecomputeSourceHashes target in Yaat.Sim.csproj. Do not edit.\n");
        source.Append("\n");
        source.Append("namespace Yaat.Sim.Data.Airport.Precompute;\n");
        source.Append("\n");
        source.Append("public static class PrecomputeSourceHashes\n");
        source.Append("{\n");
        source.Append("    public const string Layout = \"").Append(setHashes[0]).Append("\";\n");
        source.Append("    public const string PushTargets = \"").Append(setHashes[1]).Append("\";\n");
        source.Append("\n");
        source.Append("    public static readonly string[] LayoutFiles =\n").Append(setFileLists[0]).Append(";\n");
        source.Append("\n");
        source.Append("    public static readonly string[] PushTargetFiles =\n").Append(setFileLists[1]).Append(";\n");
        source.Append("}\n");

        string generated = source.ToString();
        if (!File.Exists(OutputPath) || File.ReadAllText(OutputPath) != generated)
        {
          Directory.CreateDirectory(Path.GetDirectoryName(OutputPath));
          File.WriteAllText(OutputPath, generated, new UTF8Encoding(false));
        }
      </Code>
    </Task>
  </UsingTask>

  <!--
    The input-set cache, the CoreCompileInputs.cache pattern: MSBuild's Hash task over the full input list (the push
    set, a superset of the layout set) written to a file with WriteOnlyWhenDifferent. File mtimes alone cannot see a
    deletion or a rename that keeps the old timestamp — the file simply leaves the generation target's Inputs and that
    target is skipped, leaving a stale hash and a file list naming a file that is gone — so the generation target's
    Inputs also name this cache file, which moves whenever the set of paths moves. The Hash task hashes item specs and
    ignores metadata, which is exactly the set of paths rather than their contents, and IgnoreCase is off so a
    case-only rename counts as a change too.
  -->
  <Target Name="WritePrecomputeSourceHashInputs" BeforeTargets="GeneratePrecomputeSourceHashes">
    <Hash ItemsToHash="@(PrecomputePushTargetSource)" IgnoreCase="false">
      <Output TaskParameter="HashResult" PropertyName="_PrecomputeInputsHash" />
    </Hash>
    <WriteLinesToFile
      File="$(MSBuildProjectDirectory)\$(IntermediateOutputPath)PrecomputeSourceHashes.inputs.cache"
      Lines="$(_PrecomputeInputsHash)"
      Overwrite="true"
      WriteOnlyWhenDifferent="true"
    />
  </Target>

  <Target
    Name="GeneratePrecomputeSourceHashes"
    BeforeTargets="CoreCompile"
    Inputs="$(MSBuildProjectFullPath);@(PrecomputeLayoutSource);@(PrecomputePushTargetSource);$(IntermediateOutputPath)PrecomputeSourceHashes.inputs.cache"
    Outputs="$(IntermediateOutputPath)PrecomputeSourceHashes.stamp;$(IntermediateOutputPath)PrecomputeSourceHashes.g.cs"
  >
    <GetFileHash Files="@(PrecomputeLayoutSource)" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Items" ItemName="_PrecomputeLayoutHashes" />
    </GetFileHash>
    <GetFileHash Files="@(PrecomputePushTargetSource)" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Items" ItemName="_PrecomputePushTargetHashes" />
    </GetFileHash>
    <WritePrecomputeSourceHashes
      LayoutHashes="@(_PrecomputeLayoutHashes)"
      PushTargetHashes="@(_PrecomputePushTargetHashes)"
      OutputPath="$(MSBuildProjectDirectory)\$(IntermediateOutputPath)PrecomputeSourceHashes.g.cs"
    />
    <Touch Files="$(MSBuildProjectDirectory)\$(IntermediateOutputPath)PrecomputeSourceHashes.stamp" AlwaysCreate="true" />
  </Target>

  <!--
    The compile item and the FileWrites entries live in their own target, which has no Inputs/Outputs and so runs on
    every build: they must be registered even when the generation target is skipped as up to date, and after a
    `dotnet clean` deletes the generated files the next build has to regenerate them.
  -->
  <Target Name="AddPrecomputeSourceHashesToCompile" BeforeTargets="CoreCompile" DependsOnTargets="GeneratePrecomputeSourceHashes">
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)PrecomputeSourceHashes.g.cs" />
      <FileWrites Include="$(IntermediateOutputPath)PrecomputeSourceHashes.g.cs" />
      <FileWrites Include="$(IntermediateOutputPath)PrecomputeSourceHashes.stamp" />
      <FileWrites Include="$(IntermediateOutputPath)PrecomputeSourceHashes.inputs.cache" />
    </ItemGroup>
  </Target>
</Project>
