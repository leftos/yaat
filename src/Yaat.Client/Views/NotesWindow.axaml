<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Yaat.Client.ViewModels"
  xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
  x:Class="Yaat.Client.Views.NotesWindow"
  x:DataType="vm:NotesViewModel"
  Icon="avares://Yaat.Client/Resources/icon.png"
  Title="Notes"
  Width="420"
  Height="320"
  MinWidth="260"
  MinHeight="180"
  CanResize="True"
>
  <DockPanel Margin="8">
    <TextBlock
      x:Name="NotesCountText"
      DockPanel.Dock="Bottom"
      Margin="0,6,0,0"
      FontSize="11"
      Foreground="{DynamicResource SubtleTextBrush}"
      Text="{Binding CountText}"
    />
    <!-- The buttons take no focus, so a click leaves the caret and the selection in the notes where the stamp goes. -->
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button
        x:Name="StampButton"
        Content="Stamp"
        Focusable="False"
        Command="{Binding StampCommand}"
        ToolTip.Tip="Insert [sim time callsign] at the cursor (Ctrl+Shift+N)"
      />
      <Button x:Name="CopyAllButton" Content="Copy all" Focusable="False" />
      <Button x:Name="SaveAsButton" Content="Save as..." Focusable="False" ToolTip.Tip="Write the notes to a file you choose" />
      <Button x:Name="PrintButton" Content="Print" Focusable="False" ToolTip.Tip="Print the notes" />
      <Button x:Name="ClearButton" Content="Clear" Focusable="False" />
    </StackPanel>
    <!-- AvaloniaEdit installs its SearchPanel (Ctrl+F find, Ctrl+H replace, regex included) over the text area. -->
    <ae:TextEditor
      x:Name="NotesEditor"
      AutomationProperties.Name="Notes"
      WordWrap="True"
      VerticalScrollBarVisibility="Auto"
      HorizontalScrollBarVisibility="Disabled"
      Padding="4"
    />
  </DockPanel>
</Window>
