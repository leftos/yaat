<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Yaat.Client.ViewModels"
  x:Class="Yaat.Client.Views.RundownsWindow"
  x:DataType="vm:MainViewModel"
  Icon="avares://Yaat.Client/Resources/icon.png"
  Title="Rundowns"
>
  <ScrollViewer HorizontalScrollBarVisibility="Auto">
    <StackPanel Margin="8" Spacing="8">
      <!-- The room's STARS RD lists, one section per list, rebuilt from code-behind. -->
      <StackPanel x:Name="ListsPanel" Spacing="2" Background="Transparent" />

      <TextBlock x:Name="EmptyText" Text="No active rundowns" Foreground="{DynamicResource SubtleTextBrush}" IsVisible="False" />

      <!-- Hold-for-release rundown, moved here from the command bar's Releases flyout. -->
      <StackPanel x:Name="HoldForReleaseSection" Spacing="8" IsVisible="{Binding HoldForReleaseActive}">
        <TextBlock Text="Hold for release" FontWeight="Bold" FontSize="13" Margin="0,0,0,4" />
        <ItemsControl ItemsSource="{Binding Rundown}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RundownAirportGroup">
              <StackPanel Spacing="2" Margin="0,0,0,8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBlock Grid.Column="0" Text="{Binding Header}" FontWeight="Bold" VerticalAlignment="Center" />
                  <Button
                    Grid.Column="1"
                    Content="Release next"
                    FontSize="11"
                    Padding="6,1"
                    IsVisible="{Binding HasDepartures}"
                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ReleaseNextAtAirportCommand}"
                    CommandParameter="{Binding Airport}"
                  />
                </Grid>
                <ItemsControl ItemsSource="{Binding Departures}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HeldDepartureItem">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="10,1,0,1">
                        <StackPanel Grid.Column="0">
                          <TextBlock Text="{Binding Display}" FontFamily="{StaticResource MonoFont}" FontSize="11" />
                          <TextBlock Text="{Binding Status}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="10" />
                        </StackPanel>
                        <Button
                          Grid.Column="1"
                          Content="Release"
                          FontSize="11"
                          Padding="6,1"
                          VerticalAlignment="Center"
                          Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ReleaseDepartureCommand}"
                          CommandParameter="{Binding Callsign}"
                        />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock
          Text="Arm with HFR &lt;airport&gt;; release here or with REL."
          Foreground="{DynamicResource SubtleTextBrush}"
          FontSize="10"
          TextWrapping="Wrap"
          Margin="0,4,0,0"
        />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
