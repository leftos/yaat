<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Yaat.Client.ViewModels"
  x:Class="Yaat.Client.Views.ActiveRunwaysWindow"
  x:DataType="vm:ActiveRunwaysWindowViewModel"
  Icon="avares://Yaat.Client/Resources/icon.png"
  Title="Active Runways"
  Background="#1E1E1E"
  Width="460"
  Height="360"
  MinWidth="380"
  MinHeight="240"
  CanResize="True"
>
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Apply" x:Name="ApplyButton" IsEnabled="{Binding !IsApplying}" />
      <Button Content="Close" x:Name="CloseButton" />
    </StackPanel>
    <TextBlock
      DockPanel.Dock="Top"
      Text="Separate runways with commas, spaces or new lines. D28L = departures only, A28R = arrivals only. Clear a row to turn on every runway; NONE turns them all off."
      TextWrapping="Wrap"
      Margin="0,0,0,12"
    />
    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ActiveRunwaysRow">
            <StackPanel Spacing="4" Margin="0,0,0,8">
              <Grid ColumnDefinitions="56,*" ColumnSpacing="10">
                <TextBlock Grid.Column="0" Text="{Binding Airport}" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding Text}" AcceptsReturn="True" TextWrapping="Wrap" />
              </Grid>
              <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="#FF8080" TextWrapping="Wrap" Margin="66,0,0,0" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>
