<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:Class="Yaat.Client.Views.ReplaceBackupDialog"
  Icon="avares://Yaat.Client/Resources/icon.png"
  Title="Back Up Before Replacing?"
  Width="440"
  SizeToContent="Height"
  CanResize="False"
  WindowStartupLocation="CenterOwner"
>
  <StackPanel Margin="16" Spacing="16">
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="BackUpButton" Content="Back Up…" IsDefault="True" />
      <Button x:Name="ReplaceWithoutBackupButton" Content="Replace Without Backup" />
      <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
