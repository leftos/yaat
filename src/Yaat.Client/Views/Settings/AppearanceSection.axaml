<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Yaat.Client.ViewModels"
  x:Class="Yaat.Client.Views.Settings.AppearanceSection"
  x:DataType="vm:SettingsViewModel"
>
  <ScrollViewer>
    <StackPanel Margin="16,8,16,16" Spacing="12">
      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="Font Sizes" FontWeight="SemiBold" />
          <Grid ColumnDefinitions="200,120" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Aircraft List" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding DataGridFontSize}" Minimum="8" Maximum="24" Increment="1" />
            <TextBlock
              Grid.Row="1"
              Grid.Column="0"
              Text="Radar Datablock"
              Foreground="{DynamicResource SubtleTextBrush}"
              VerticalAlignment="Center"
            />
            <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding RadarDatablockFontSize}" Minimum="8" Maximum="24" Increment="1" />
            <TextBlock
              Grid.Row="2"
              Grid.Column="0"
              Text="Radar Tag Flyouts"
              Foreground="{DynamicResource SubtleTextBrush}"
              VerticalAlignment="Center"
            />
            <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding RadarFlyoutFontSize}" Minimum="8" Maximum="24" Increment="1" />
            <TextBlock
              Grid.Row="3"
              Grid.Column="0"
              Text="Ground Datablock"
              Foreground="{DynamicResource SubtleTextBrush}"
              VerticalAlignment="Center"
            />
            <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding GroundDatablockFontSize}" Minimum="8" Maximum="24" Increment="1" />
            <TextBlock
              Grid.Row="4"
              Grid.Column="0"
              Text="Ground Labels (taxi/runway/node)"
              Foreground="{DynamicResource SubtleTextBrush}"
              VerticalAlignment="Center"
            />
            <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding GroundLabelFontSize}" Minimum="8" Maximum="24" Increment="1" />
            <TextBlock
              Grid.Row="5"
              Grid.Column="0"
              Text="Terminal (output + input)"
              Foreground="{DynamicResource SubtleTextBrush}"
              VerticalAlignment="Center"
            />
            <NumericUpDown Grid.Row="5" Grid.Column="1" Value="{Binding TerminalFontSize}" Minimum="8" Maximum="24" Increment="1" />
            <TextBlock
              Grid.Row="6"
              Grid.Column="0"
              Text="Interface (tabs, buttons, lists)"
              Foreground="{DynamicResource SubtleTextBrush}"
              VerticalAlignment="Center"
            />
            <NumericUpDown Grid.Row="6" Grid.Column="1" Value="{Binding InterfaceFontSize}" Minimum="8" Maximum="24" Increment="1" />
            <TextBlock Grid.Row="7" Grid.Column="0" Text="Strips Zoom %" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="7" Grid.Column="1" Value="{Binding StripsZoomPercent}" Minimum="50" Maximum="200" Increment="10" />
            <TextBlock Grid.Row="8" Grid.Column="0" Text="vTDLS Zoom %" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="8" Grid.Column="1" Value="{Binding TdlsZoomPercent}" Minimum="50" Maximum="200" Increment="10" />
          </Grid>
          <TextBlock
            Text="Defaults: 12 for datablocks/lists/terminal/interface, 13 for ground labels, Strips 80% / vTDLS 100%. Aircraft list also responds to Ctrl+Plus / Ctrl+Minus / Ctrl+0 while focused; Strips also has on-panel zoom buttons."
            TextWrapping="Wrap"
            Foreground="{DynamicResource SubtleTextBrush}"
            FontSize="11"
          />
        </StackPanel>
      </Border>
      <Border Classes="card" IsVisible="{Binding IsMacOs}">
        <StackPanel Spacing="12">
          <TextBlock Text="Graphics" FontWeight="SemiBold" />
          <TextBlock Text="Renderer:" Foreground="{DynamicResource SubtleTextBrush}" />
          <ComboBox
            ItemsSource="{Binding RendererModeOptions}"
            SelectedIndex="{Binding SelectedRendererModeIndex}"
            Width="200"
            HorizontalAlignment="Left"
          />
          <TextBlock
            Text="Metal is recommended on Apple Silicon Macs. Switch to OpenGL only if you see visual glitches, or Software as a last resort. Takes effect after you restart YAAT."
            TextWrapping="Wrap"
            Foreground="{DynamicResource SubtleTextBrush}"
            FontSize="11"
          />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
