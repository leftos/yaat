<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Yaat.Client.ViewModels"
  x:Class="Yaat.Client.Views.Settings.CommandInputSection"
  x:DataType="vm:SettingsViewModel"
>
  <ScrollViewer>
    <StackPanel Margin="16,8,16,16" Spacing="12">
      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="Command Input" FontWeight="SemiBold" />
          <StackPanel Spacing="4">
            <TextBlock Text="Signature Help Placement:" Foreground="{DynamicResource SubtleTextBrush}" />
            <ComboBox
              ItemsSource="{Binding SignatureHelpPlacementOptions}"
              SelectedIndex="{Binding SelectedSignatureHelpPlacementIndex}"
              Width="120"
              HorizontalAlignment="Left"
            />
            <TextBlock
              Text="Controls whether the command signature help tooltip appears above or below the command input."
              TextWrapping="Wrap"
              Foreground="{DynamicResource SubtleTextBrush}"
              FontSize="11"
            />
          </StackPanel>
          <StackPanel Spacing="4">
            <CheckBox Content="Auto-expand highlighted suggestion on Enter" IsChecked="{Binding AutoExpandSuggestionOnEnter}" />
            <TextBlock
              Text="The top suggestion is highlighted automatically once you've typed part of a value (or manually via Up/Down); pressing Enter inserts the highlighted suggestion before sending — equivalent to pressing Tab then Enter. When off, Enter sends the typed text as-is."
              TextWrapping="Wrap"
              Foreground="{DynamicResource SubtleTextBrush}"
              FontSize="11"
            />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
