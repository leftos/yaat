<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Yaat.Client.ViewModels"
  x:Class="Yaat.Client.Views.Settings.ScenarioDefaultsSection"
  x:DataType="vm:SettingsViewModel"
>
  <ScrollViewer>
    <StackPanel Margin="16,8,16,16" Spacing="12">
      <TextBlock
        Text="Defaults for new rooms, applied when a scenario loads. The room's live values are in the session flyout (the gear in the command bar)."
        TextWrapping="Wrap"
        Foreground="{DynamicResource SubtleTextBrush}"
        FontSize="11"
        FontStyle="Italic"
      />
      <Border Classes="card">
        <StackPanel Spacing="12">
          <StackPanel Spacing="4">
            <CheckBox Content="Solo training mode" IsChecked="{Binding SoloTrainingMode}" />
            <TextBlock
              Text="Aircraft make their own pilot transmissions and typed natural-language ATC commands can be mapped to YAAT commands after normal parsing fails."
              TextWrapping="Wrap"
              Foreground="{DynamicResource SubtleTextBrush}"
              FontSize="11"
              Margin="28,0,0,0"
            />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="Pilot go-around probability (default)" FontWeight="SemiBold" Margin="0,0,0,2" />
            <TextBlock
              Text="Per-approach chance that AI aircraft in solo training spontaneously go around on final. The default for new rooms, used for a scenario with no saved value of its own; the room's live value is in the session flyout."
              TextWrapping="Wrap"
              Foreground="{DynamicResource SubtleTextBrush}"
              FontSize="11"
              Margin="0,0,0,4"
            />
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="12,0,0,0">
              <Slider
                Value="{Binding SoloGoAroundProbabilityPercent}"
                Minimum="0"
                Maximum="100"
                TickFrequency="5"
                Width="240"
                VerticalAlignment="Center"
              />
              <TextBlock
                Text="{Binding SoloGoAroundProbabilityPercent, StringFormat='{}{0}%'}"
                VerticalAlignment="Center"
                Width="48"
                Foreground="{DynamicResource SubtleTextBrush}"
              />
            </StackPanel>
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="Solo training" FontWeight="SemiBold" Margin="0,0,0,2" />
            <TextBlock
              Text="How often parked aircraft call up for taxi, and how fast arrival generators spawn traffic, in solo training. Defaults for new rooms; the scenario setup dialog starts from them, and the room's live values are in the session flyout."
              TextWrapping="Wrap"
              Foreground="{DynamicResource SubtleTextBrush}"
              FontSize="11"
              Margin="0,0,0,4"
            />
            <TextBlock Text="Parking call-up interval:" Foreground="{DynamicResource SubtleTextBrush}" Margin="12,0,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="12,0,0,0">
              <Slider
                Value="{Binding SoloParkingInitialCallupIntervalSeconds}"
                Minimum="0"
                Maximum="120"
                TickFrequency="10"
                IsSnapToTickEnabled="True"
                Width="240"
                VerticalAlignment="Center"
              />
              <TextBlock
                Text="{Binding SoloParkingInitialCallupIntervalLabel}"
                VerticalAlignment="Center"
                MinWidth="96"
                Foreground="{DynamicResource SubtleTextBrush}"
              />
            </StackPanel>
            <TextBlock Text="Arrival generator rate:" Foreground="{DynamicResource SubtleTextBrush}" Margin="12,4,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="12,0,0,0">
              <Slider
                Value="{Binding SoloArrivalGeneratorRatePercent}"
                Minimum="0"
                Maximum="100"
                TickFrequency="5"
                IsSnapToTickEnabled="True"
                Width="240"
                VerticalAlignment="Center"
              />
              <TextBlock
                Text="{Binding SoloArrivalGeneratorRatePercent, StringFormat='{}{0}%'}"
                VerticalAlignment="Center"
                Width="48"
                Foreground="{DynamicResource SubtleTextBrush}"
              />
            </StackPanel>
          </StackPanel>
          <StackPanel Spacing="4">
            <CheckBox Content="Auto-accept handoffs to unattended positions" IsChecked="{Binding AutoAcceptEnabled}" />
            <StackPanel Spacing="4" IsVisible="{Binding AutoAcceptEnabled}" Margin="28,0,0,0">
              <TextBlock Text="Delay (seconds):" Foreground="{DynamicResource SubtleTextBrush}" />
              <NumericUpDown Value="{Binding AutoAcceptDelaySeconds}" Minimum="0" Maximum="60" Increment="1" Width="120" HorizontalAlignment="Left" />
              <TextBlock
                Text="Handoffs are automatically accepted after this delay. Set to 0 for immediate acceptance."
                TextWrapping="Wrap"
                Foreground="{DynamicResource SubtleTextBrush}"
                FontSize="11"
              />
            </StackPanel>
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="Command run delay (seconds):" Foreground="{DynamicResource SubtleTextBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Min" VerticalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}" />
              <NumericUpDown Value="{Binding CommandRunDelayMinSeconds}" Minimum="0" Maximum="60" Increment="1" Width="110" />
              <TextBlock Text="Max" VerticalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}" />
              <NumericUpDown Value="{Binding CommandRunDelayMaxSeconds}" Minimum="0" Maximum="60" Increment="1" Width="110" />
            </StackPanel>
            <TextBlock
              Text="Simulates pilot reaction / FMC setup time: commands take effect after a random delay in this range (set both equal for a fixed delay). A few seconds (e.g. 3-8) is realistic. Frequency changes are never delayed. Set max to 0 to disable."
              TextWrapping="Wrap"
              Foreground="{DynamicResource SubtleTextBrush}"
              FontSize="11"
            />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="Default Auto-Delete:" Foreground="{DynamicResource SubtleTextBrush}" />
            <ComboBox
              ItemsSource="{Binding AutoDeleteOptions}"
              SelectedIndex="{Binding SelectedAutoDeleteIndex}"
              Width="220"
              HorizontalAlignment="Left"
            />
            <TextBlock
              Text="Your default preference, applied when you load a scenario. Other RPOs can change the active setting via the session dropdown in the command bar."
              TextWrapping="Wrap"
              Foreground="{DynamicResource SubtleTextBrush}"
              FontSize="11"
            />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="Auto-delete departures beyond (nm)" Foreground="{DynamicResource SubtleTextBrush}" />
            <NumericUpDown
              Value="{Binding DepartureAutoDeleteDistanceNm}"
              Minimum="1"
              Maximum="500"
              Increment="1"
              Width="110"
              HorizontalAlignment="Left"
              ToolTip.Tip="Removes departures from the primary airport once they are farther than this from it. Leave blank to keep them."
            />
          </StackPanel>
          <StackPanel Spacing="4">
            <CheckBox Content="Validate DCT fixes against programmed route" IsChecked="{Binding ValidateDctFixes}" />
            <TextBlock
              Text="When enabled, DCT to a fix not in the aircraft's route or expected approach is rejected. Use DCTF to override. Requires issuing EAPP (Expect Approach) to program approach fixes."
              TextWrapping="Wrap"
              Foreground="{DynamicResource SubtleTextBrush}"
              FontSize="11"
              Margin="28,0,0,0"
            />
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="Simulation Shortcuts" FontWeight="SemiBold" Margin="0,8,0,0" />
          <StackPanel Spacing="4">
            <TextBlock Text="Auto-clear aircraft to land" FontWeight="SemiBold" Margin="0,0,0,2" />
            <TextBlock
              Text="Aircraft on final approach are automatically cleared to land without requiring a CLAND command. Configure per position type."
              TextWrapping="Wrap"
              Foreground="{DynamicResource SubtleTextBrush}"
              FontSize="11"
              Margin="0,0,0,4"
            />
            <StackPanel Orientation="Horizontal" Spacing="16" Margin="12,0,0,0">
              <CheckBox Content="GND" IsChecked="{Binding AutoClearedToLandGnd}" />
              <CheckBox Content="TWR" IsChecked="{Binding AutoClearedToLandTwr}" />
              <CheckBox Content="APP" IsChecked="{Binding AutoClearedToLandApp}" />
              <CheckBox Content="CTR" IsChecked="{Binding AutoClearedToLandCtr}" />
            </StackPanel>
          </StackPanel>
          <StackPanel Spacing="4">
            <CheckBox Content="Aircraft cross runways automatically" IsChecked="{Binding AutoCrossRunway}" />
            <TextBlock
              Text="Taxiing aircraft cross runways without stopping. No CROSS command needed. Hold-short commands and destination runway hold-shorts still apply."
              TextWrapping="Wrap"
              Foreground="{DynamicResource SubtleTextBrush}"
              FontSize="11"
              Margin="28,0,0,0"
            />
          </StackPanel>
          <StackPanel Spacing="4">
            <CheckBox Content="Auto pull-up to hold short of parallel runway after landing" IsChecked="{Binding AutoPullUpToParallel}" />
            <TextBlock
              Text="After exiting the landing runway, aircraft automatically pull up to the parallel runway hold-short without a TAXI command. On by default."
              TextWrapping="Wrap"
              Foreground="{DynamicResource SubtleTextBrush}"
              FontSize="11"
              Margin="28,0,0,0"
            />
          </StackPanel>
          <StackPanel Spacing="4">
            <CheckBox Content="Auto go-around when the runway is occupied on short final" IsChecked="{Binding AutoGoAroundOnOccupiedRunway}" />
            <TextBlock
              Text="Arrivals about 30 seconds from the threshold go around on their own when another aircraft is on their runway, unless it has landed or departed far enough down the runway (7110.65 3-10-3). On by default."
              TextWrapping="Wrap"
              Foreground="{DynamicResource SubtleTextBrush}"
              FontSize="11"
              Margin="28,0,0,0"
            />
          </StackPanel>
          <StackPanel Spacing="4">
            <CheckBox Content="Auto rejected takeoff when the runway is blocked ahead" IsChecked="{Binding AutoRejectTakeoffOnOccupiedRunway}" />
            <TextBlock
              Text="A departure on its takeoff roll aborts on its own when another aircraft blocks the runway ahead: always at low speed, at high speed only when the blocker cannot be safely overflown. It brakes to a stop and holds in position awaiting instructions. On by default."
              TextWrapping="Wrap"
              Foreground="{DynamicResource SubtleTextBrush}"
              FontSize="11"
              Margin="28,0,0,0"
            />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="Auto arrival spacing behind traffic on the runway" FontWeight="SemiBold" Margin="0,0,0,2" />
            <TextBlock
              Text="The simulated approach controller slows a scenario arrival whose leader will still be on the runway when it reaches the threshold; inside 10 nm with you on Ground, the simulated tower assigns final approach speed instead. Applies when you work Ground or Tower; a student on Approach or Center is the approach controller. Both on by default."
              TextWrapping="Wrap"
              Foreground="{DynamicResource SubtleTextBrush}"
              FontSize="11"
              Margin="0,0,0,4"
            />
            <StackPanel Orientation="Horizontal" Spacing="16" Margin="12,0,0,0">
              <CheckBox Content="GND" IsChecked="{Binding AutoArrivalSpacingOnOccupiedRunwayGnd}" />
              <CheckBox Content="TWR" IsChecked="{Binding AutoArrivalSpacingOnOccupiedRunwayTwr}" />
            </StackPanel>
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="VFR commands for IFR aircraft:" Foreground="{DynamicResource SubtleTextBrush}" />
            <ComboBox
              ItemsSource="{Binding VfrCommandsForIfrOptions}"
              SelectedIndex="{Binding SelectedVfrCommandsForIfrIndex}"
              Width="240"
              HorizontalAlignment="Left"
            />
            <TextBlock
              Text="Which VFR-only commands (pattern entry and maneuvers, touch-and-go, low approach, cleared for the option, FOLLOW, VFR holds, CM A/B, and the pattern CTO modifiers) you can give an IFR aircraft without issuing CIFR first. The aircraft stays IFR either way. Defaults to EF only, so an IFR arrival on a visual can be moved to another runway."
              TextWrapping="Wrap"
              Foreground="{DynamicResource SubtleTextBrush}"
              FontSize="11"
            />
          </StackPanel>
          <StackPanel Spacing="4">
            <CheckBox Content="Show sim-initiated pilot transmissions as pilot speech (RPO mode)" IsChecked="{Binding RpoShowPilotSpeech}" />
            <TextBlock
              Text="Renders auto-generated pilot reports (traffic in sight, holding short, going around, midfield/short-final reminders, etc.) as green pilot speech with the spelled-out spoken form. Default off — preserves the orange Warning text."
              TextWrapping="Wrap"
              Foreground="{DynamicResource SubtleTextBrush}"
              FontSize="11"
              Margin="28,0,0,0"
            />
          </StackPanel>
          <StackPanel Spacing="4">
            <CheckBox Content="Audible alert on pilot transmissions" IsChecked="{Binding RpoPilotSpeechAudibleAlert}" />
            <TextBlock
              Text="Plays a short ding when a sim-initiated pilot transmission appears. Independent of the visual setting above. Does not fire on AS-prefix SAY commands you typed yourself."
              TextWrapping="Wrap"
              Foreground="{DynamicResource SubtleTextBrush}"
              FontSize="11"
              Margin="28,0,0,0"
            />
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Classes="card">
        <StackPanel Spacing="4">
          <TextBlock Text="Room only: set in the session flyout" FontWeight="SemiBold" />
          <TextBlock
            Text="These have no default here: they belong to the room, and any RPO in it changes them from the command bar."
            TextWrapping="Wrap"
            Foreground="{DynamicResource SubtleTextBrush}"
            FontSize="11"
            Margin="0,0,0,4"
          />
          <TextBlock
            Text="• Live traffic: SWIM on or off, the ceiling, the filters, and assuming live traffic"
            TextWrapping="Wrap"
            Foreground="{DynamicResource SubtleTextBrush}"
            Margin="12,0,0,0"
          />
          <TextBlock
            Text="• Releases: the hold-for-release rundown, on the Releases button beside the gear once hold for release is armed"
            TextWrapping="Wrap"
            Foreground="{DynamicResource SubtleTextBrush}"
            Margin="12,0,0,0"
          />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
