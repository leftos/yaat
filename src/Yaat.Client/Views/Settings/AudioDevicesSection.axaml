<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Yaat.Client.ViewModels"
  x:Class="Yaat.Client.Views.Settings.AudioDevicesSection"
  x:DataType="vm:SettingsViewModel"
>
  <ScrollViewer>
    <StackPanel Margin="12" Spacing="12">
      <StackPanel Spacing="4">
        <TextBlock Text="Input device:" Foreground="{DynamicResource SubtleTextBrush}" />
        <ComboBox ItemsSource="{Binding AudioInputDevices}" SelectedItem="{Binding SelectedAudioInputDeviceDisplay}" Width="360" />
        <TextBlock
          Text="Pick the microphone YAAT should record from for push-to-talk speech recognition, or leave on System default to use whichever mic Windows is currently set to."
          TextWrapping="Wrap"
          Foreground="{DynamicResource SubtleTextBrush}"
          FontSize="11"
        />
      </StackPanel>
      <StackPanel Spacing="4">
        <TextBlock Text="Output device:" Foreground="{DynamicResource SubtleTextBrush}" />
        <ComboBox ItemsSource="{Binding AudioOutputDevices}" SelectedItem="{Binding SelectedAudioOutputDeviceDisplay}" Width="360" />
        <TextBlock
          Text="Used for pilot text-to-speech playback and the SAY/warning notification chime. Leave on System default to follow whichever output Windows is currently set to."
          TextWrapping="Wrap"
          Foreground="{DynamicResource SubtleTextBrush}"
          FontSize="11"
        />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
