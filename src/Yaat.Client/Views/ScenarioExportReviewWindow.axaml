<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:Class="Yaat.Client.Views.ScenarioExportReviewWindow"
  Icon="avares://Yaat.Client/Resources/icon.png"
  Title="Exported Scenario — Needs Review"
  Width="480"
  Height="360"
  MinWidth="320"
  MinHeight="200"
  WindowStartupLocation="CenterOwner"
  CanResize="True"
>
  <DockPanel Margin="16">
    <TextBlock
      DockPanel.Dock="Top"
      TextWrapping="Wrap"
      Margin="0,0,0,10"
      Text="These aircraft need preset commands or deletion before the scenario is usable:"
    />
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button Content="Copy" x:Name="CopyButton" />
      <Button Content="Close" x:Name="CloseButton" Width="80" IsDefault="True" IsCancel="True" />
    </StackPanel>
    <ListBox x:Name="FlagList" FontFamily="{StaticResource MonoFont}" />
  </DockPanel>
</Window>
