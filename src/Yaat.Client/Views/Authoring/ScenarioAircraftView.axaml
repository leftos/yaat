<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Yaat.Client.ViewModels.Authoring"
  x:Class="Yaat.Client.Views.Authoring.ScenarioAircraftView"
  x:DataType="vm:ScenarioAircraftViewModel"
>
  <UserControl.Styles>
    <Style Selector="ScrollViewer#DetailPanel TextBlock.lbl">
      <Setter Property="Foreground" Value="#B0B0B0" />
      <Setter Property="Margin" Value="0,6,0,2" />
    </Style>
    <Style Selector="ScrollViewer#DetailPanel TextBlock.err">
      <Setter Property="Foreground" Value="#E06C6C" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style Selector="ScrollViewer#DetailPanel TextBlock.hint">
      <Setter Property="Foreground" Value="#D9A54A" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style Selector="ScrollViewer#DetailPanel TextBlock.head">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="0,12,0,0" />
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#242424" BorderBrush="#3D3D3D" BorderThickness="0,0,0,1" Padding="8,5">
      <StackPanel Orientation="Horizontal" Spacing="5">
        <Button x:Name="AddAircraftButton" Content="Add" Padding="9,3" Command="{Binding AddAircraftCommand}" />
        <Button x:Name="DuplicateAircraftButton" Content="Duplicate" Padding="9,3" Command="{Binding DuplicateAircraftCommand}" />
        <Button x:Name="RemoveAircraftButton" Content="Remove" Padding="9,3" Command="{Binding RemoveAircraftCommand}" />
      </StackPanel>
    </Border>
    <ScrollViewer
      x:Name="DetailPanel"
      DockPanel.Dock="Right"
      Width="320"
      Background="#232323"
      BorderBrush="#3D3D3D"
      BorderThickness="1,0,0,0"
      IsVisible="{Binding IsDetailVisible}"
    >
      <StackPanel Margin="10,4,10,10">
        <TextBlock Classes="head" Text="Aircraft" />
        <TextBlock Classes="lbl" Text="Callsign" />
        <TextBox x:Name="CallsignBox" Text="{Binding Callsign}" Tag="{Binding CommitCallsignCommand}" />
        <TextBlock Classes="lbl" Text="Type" />
        <AutoCompleteBox
          x:Name="TypeBox"
          Text="{Binding AircraftType, Mode=TwoWay}"
          ItemsSource="{Binding TypeSuggestions}"
          FilterMode="None"
          MinimumPrefixLength="1"
          Tag="{Binding CommitAircraftTypeCommand}"
          SelectionChanged="OnListPicked"
          DropDownClosed="OnListClosed"
        />
        <TextBlock Classes="hint" Text="{Binding TypeHint}" IsVisible="{Binding TypeHint, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <TextBlock Classes="lbl" Text="Transponder" />
        <TextBox x:Name="TransponderBox" Text="{Binding Transponder}" Tag="{Binding CommitTransponderCommand}" />
        <TextBlock Classes="lbl" Text="Spawn delay" />
        <TextBox x:Name="SpawnDelayBox" Text="{Binding SpawnDelay}" Tag="{Binding CommitSpawnDelayCommand}" />
        <TextBlock
          Classes="err"
          Text="{Binding SpawnDelayError}"
          IsVisible="{Binding SpawnDelayError, Converter={x:Static ObjectConverters.IsNotNull}}"
        />
        <TextBlock Classes="lbl" Text="Taxi time (seconds)" />
        <TextBox x:Name="TaxiTimeBox" Text="{Binding TaxiTime}" Tag="{Binding CommitTaxiTimeCommand}" />
        <TextBlock
          Classes="err"
          Text="{Binding TaxiTimeError}"
          IsVisible="{Binding TaxiTimeError, Converter={x:Static ObjectConverters.IsNotNull}}"
        />
        <TextBlock Classes="lbl" Text="Airport" />
        <ComboBox
          x:Name="AirportBox"
          IsEditable="True"
          HorizontalAlignment="Stretch"
          Text="{Binding Airport, Mode=TwoWay}"
          ItemsSource="{Binding AirportOptions}"
          Tag="{Binding CommitAirportCommand}"
          SelectionChanged="OnListPicked"
          DropDownClosed="OnListClosed"
        />
        <TextBlock Classes="lbl" Text="Approach" />
        <TextBox x:Name="ApproachBox" Text="{Binding Approach}" Tag="{Binding CommitApproachCommand}" />
        <TextBlock Classes="lbl" Text="Difficulty" />
        <TextBox x:Name="DifficultyBox" Text="{Binding Difficulty}" Tag="{Binding CommitDifficultyCommand}" />
        <CheckBox x:Name="AltitudeProfileBox" Margin="0,8,0,0" Content="On altitude profile" IsChecked="{Binding OnAltitudeProfile}" />
        <TextBlock Classes="lbl" Text="RPO note" />
        <TextBox
          x:Name="RpoNoteBox"
          AcceptsReturn="True"
          TextWrapping="Wrap"
          MinHeight="60"
          Text="{Binding RpoNote}"
          Tag="{Binding CommitRpoNoteCommand}"
        />

        <TextBlock Classes="head" Text="Starting conditions" />
        <TextBlock Classes="lbl" Text="Kind" />
        <ComboBox
          x:Name="StartKindPicker"
          HorizontalAlignment="Stretch"
          ItemsSource="{Binding StartKindOptions}"
          DisplayMemberBinding="{Binding Label}"
          SelectedItem="{Binding StartKindSelection}"
        />
        <StackPanel IsVisible="{Binding ShowsParking}">
          <TextBlock Classes="lbl" Text="Parking" />
          <Grid ColumnDefinitions="*,6,Auto">
            <TextBox x:Name="ParkingBox" Grid.Column="0" Text="{Binding Parking}" Tag="{Binding CommitParkingCommand}" />
            <Button
              x:Name="PickParkingButton"
              Grid.Column="2"
              Content="Pick on map"
              Padding="9,3"
              IsEnabled="{Binding CanPickParking}"
              Click="OnPickParkingClick"
            />
          </Grid>
        </StackPanel>
        <StackPanel IsVisible="{Binding ShowsRunway}">
          <TextBlock Classes="lbl" Text="Runway" />
          <TextBox x:Name="RunwayBox" Text="{Binding Runway}" Tag="{Binding CommitRunwayCommand}" />
        </StackPanel>
        <StackPanel IsVisible="{Binding ShowsFix}">
          <TextBlock Classes="lbl" Text="Fix or FRD" />
          <TextBox x:Name="FixBox" Text="{Binding Fix}" Tag="{Binding CommitFixCommand}" />
        </StackPanel>
        <StackPanel IsVisible="{Binding ShowsCoordinates}">
          <TextBlock Classes="lbl" Text="Latitude" />
          <TextBox x:Name="LatitudeBox" Text="{Binding Latitude}" Tag="{Binding CommitLatitudeCommand}" />
          <TextBlock
            Classes="err"
            Text="{Binding LatitudeError}"
            IsVisible="{Binding LatitudeError, Converter={x:Static ObjectConverters.IsNotNull}}"
          />
          <TextBlock Classes="lbl" Text="Longitude" />
          <TextBox x:Name="LongitudeBox" Text="{Binding Longitude}" Tag="{Binding CommitLongitudeCommand}" />
          <TextBlock
            Classes="err"
            Text="{Binding LongitudeError}"
            IsVisible="{Binding LongitudeError, Converter={x:Static ObjectConverters.IsNotNull}}"
          />
        </StackPanel>
        <StackPanel IsVisible="{Binding ShowsAltitude}">
          <TextBlock Classes="lbl" Text="Altitude (ft)" />
          <TextBox x:Name="AltitudeBox" Text="{Binding Altitude}" Tag="{Binding CommitAltitudeCommand}" />
          <TextBlock
            Classes="err"
            Text="{Binding AltitudeError}"
            IsVisible="{Binding AltitudeError, Converter={x:Static ObjectConverters.IsNotNull}}"
          />
        </StackPanel>
        <StackPanel IsVisible="{Binding ShowsSpeed}">
          <TextBlock Classes="lbl" Text="Speed (kt)" />
          <TextBox x:Name="SpeedBox" Text="{Binding Speed}" Tag="{Binding CommitSpeedCommand}" />
          <TextBlock Classes="err" Text="{Binding SpeedError}" IsVisible="{Binding SpeedError, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
        <StackPanel IsVisible="{Binding ShowsHeading}">
          <TextBlock Classes="lbl" Text="Heading (deg)" />
          <TextBox x:Name="HeadingBox" Text="{Binding Heading}" Tag="{Binding CommitHeadingCommand}" />
          <TextBlock
            Classes="err"
            Text="{Binding HeadingError}"
            IsVisible="{Binding HeadingError, Converter={x:Static ObjectConverters.IsNotNull}}"
          />
        </StackPanel>
        <StackPanel IsVisible="{Binding ShowsNavigationPath}">
          <TextBlock Classes="lbl" Text="Navigation path" />
          <TextBox x:Name="NavigationPathBox" Text="{Binding NavigationPath}" Tag="{Binding CommitNavigationPathCommand}" />
        </StackPanel>
        <StackPanel IsVisible="{Binding ShowsDistanceFromRunway}">
          <TextBlock Classes="lbl" Text="Distance from runway (nm)" />
          <TextBox x:Name="DistanceBox" Text="{Binding DistanceFromRunway}" Tag="{Binding CommitDistanceFromRunwayCommand}" />
          <TextBlock
            Classes="err"
            Text="{Binding DistanceFromRunwayError}"
            IsVisible="{Binding DistanceFromRunwayError, Converter={x:Static ObjectConverters.IsNotNull}}"
          />
        </StackPanel>

        <TextBlock Classes="head" Text="Flight plan" />
        <CheckBox x:Name="HasFlightPlanBox" Margin="0,6,0,0" Content="Has flight plan" IsChecked="{Binding HasFlightPlan}" />
        <StackPanel IsVisible="{Binding HasFlightPlan}">
          <TextBlock Classes="lbl" Text="Rules" />
          <ComboBox
            x:Name="FlightRulesPicker"
            HorizontalAlignment="Stretch"
            ItemsSource="{Binding FlightRulesOptions}"
            SelectedItem="{Binding FlightRulesPick}"
          />
          <TextBlock Classes="lbl" Text="Departure" />
          <TextBox x:Name="DepartureBox" Text="{Binding Departure}" Tag="{Binding CommitDepartureCommand}" />
          <TextBlock Classes="lbl" Text="Destination" />
          <TextBox x:Name="DestinationBox" Text="{Binding Destination}" Tag="{Binding CommitDestinationCommand}" />
          <TextBlock Classes="lbl" Text="Cruise altitude (ft)" />
          <TextBox x:Name="CruiseAltitudeBox" Text="{Binding CruiseAltitude}" Tag="{Binding CommitCruiseAltitudeCommand}" />
          <TextBlock
            Classes="err"
            Text="{Binding CruiseAltitudeError}"
            IsVisible="{Binding CruiseAltitudeError, Converter={x:Static ObjectConverters.IsNotNull}}"
          />
          <TextBlock Classes="lbl" Text="Cruise speed (kt)" />
          <TextBox x:Name="CruiseSpeedBox" Text="{Binding CruiseSpeed}" Tag="{Binding CommitCruiseSpeedCommand}" />
          <TextBlock
            Classes="err"
            Text="{Binding CruiseSpeedError}"
            IsVisible="{Binding CruiseSpeedError, Converter={x:Static ObjectConverters.IsNotNull}}"
          />
          <TextBlock Classes="lbl" Text="Route" />
          <TextBox x:Name="RouteBox" TextWrapping="Wrap" Text="{Binding FlightPlanRoute}" Tag="{Binding CommitFlightPlanRouteCommand}" />
          <TextBlock Classes="lbl" Text="Remarks" />
          <TextBox x:Name="RemarksBox" TextWrapping="Wrap" Text="{Binding Remarks}" Tag="{Binding CommitRemarksCommand}" />
          <TextBlock Classes="lbl" Text="Filed type" />
          <TextBox x:Name="FiledTypeBox" Text="{Binding FiledType}" Tag="{Binding CommitFiledTypeCommand}" />
        </StackPanel>

        <TextBlock Classes="head" Text="Preset commands" />
        <ItemsControl x:Name="PresetList" ItemsSource="{Binding Presets}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ScenarioPresetRowViewModel">
              <Border Margin="0,6,0,0" Padding="6" Background="#2A2A2A" BorderBrush="#3D3D3D" BorderThickness="1" CornerRadius="3">
                <StackPanel Spacing="3">
                  <Grid ColumnDefinitions="*,6,64">
                    <TextBox
                      x:Name="PresetCommandBox"
                      Grid.Column="0"
                      PlaceholderText="Command"
                      Text="{Binding Command}"
                      Tag="{Binding CommitCommandCommand}"
                    />
                    <TextBox
                      x:Name="PresetOffsetBox"
                      Grid.Column="2"
                      PlaceholderText="0:00"
                      Text="{Binding Offset}"
                      Tag="{Binding CommitOffsetCommand}"
                    />
                  </Grid>
                  <TextBlock
                    Classes="err"
                    Text="{Binding CommandError}"
                    IsVisible="{Binding CommandError, Converter={x:Static ObjectConverters.IsNotNull}}"
                  />
                  <TextBlock
                    Classes="err"
                    Text="{Binding OffsetError}"
                    IsVisible="{Binding OffsetError, Converter={x:Static ObjectConverters.IsNotNull}}"
                  />
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button x:Name="PresetMoveUpButton" Content="Up" Padding="6,2" Command="{Binding MoveUpCommand}" />
                    <Button x:Name="PresetMoveDownButton" Content="Down" Padding="6,2" Command="{Binding MoveDownCommand}" />
                    <Button x:Name="PresetDuplicateButton" Content="Duplicate" Padding="6,2" Command="{Binding DuplicateCommand}" />
                    <Button x:Name="PresetRemoveButton" Content="Remove" Padding="6,2" Command="{Binding RemoveCommand}" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button x:Name="AddPresetButton" Margin="0,6,0,0" Content="Add preset" Padding="9,3" Command="{Binding AddPresetCommand}" />

        <TextBlock Classes="head" Text="Auto-track" />
        <CheckBox x:Name="HasAutoTrackBox" Margin="0,6,0,0" Content="Auto-track" IsChecked="{Binding HasAutoTrack}" />
        <StackPanel IsVisible="{Binding HasAutoTrack}">
          <TextBlock Classes="lbl" Text="Position" />
          <ComboBox
            x:Name="AutoTrackPositionPicker"
            HorizontalAlignment="Stretch"
            ItemsSource="{Binding AutoTrackPositionOptions}"
            DisplayMemberBinding="{Binding Label}"
            SelectedItem="{Binding AutoTrackPositionSelection}"
          />
          <TextBlock Classes="lbl" Text="Handoff delay (seconds)" />
          <TextBox x:Name="HandoffDelayBox" Text="{Binding HandoffDelay}" Tag="{Binding CommitHandoffDelayCommand}" />
          <TextBlock
            Classes="err"
            Text="{Binding HandoffDelayError}"
            IsVisible="{Binding HandoffDelayError, Converter={x:Static ObjectConverters.IsNotNull}}"
          />
          <TextBlock Classes="lbl" Text="Scratchpad" />
          <TextBox x:Name="ScratchPadBox" Text="{Binding ScratchPad}" Tag="{Binding CommitScratchPadCommand}" />
          <TextBlock Classes="lbl" Text="Interim altitude" />
          <TextBox x:Name="InterimAltitudeBox" Text="{Binding InterimAltitude}" Tag="{Binding CommitInterimAltitudeCommand}" />
          <TextBlock Classes="lbl" Text="Cleared altitude" />
          <TextBox x:Name="ClearedAltitudeBox" Text="{Binding ClearedAltitude}" Tag="{Binding CommitClearedAltitudeCommand}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <DataGrid
      x:Name="AircraftGrid"
      ItemsSource="{Binding Rows}"
      SelectedItem="{Binding Selected, Mode=TwoWay}"
      SelectionMode="Single"
      IsReadOnly="True"
      CanUserSortColumns="True"
      CanUserReorderColumns="True"
      CanUserResizeColumns="True"
      GridLinesVisibility="Horizontal"
    >
      <DataGrid.Columns>
        <DataGridTextColumn x:DataType="vm:ScenarioAircraftRowViewModel" Header="Callsign" Binding="{Binding Callsign}" SortMemberPath="Callsign" />
        <DataGridTextColumn x:DataType="vm:ScenarioAircraftRowViewModel" Header="Type" Binding="{Binding Type}" SortMemberPath="Type" />
        <DataGridTextColumn
          x:DataType="vm:ScenarioAircraftRowViewModel"
          Header="Transponder"
          Binding="{Binding Transponder}"
          SortMemberPath="Transponder"
        />
        <DataGridTextColumn
          x:DataType="vm:ScenarioAircraftRowViewModel"
          Header="Spawn delay"
          Binding="{Binding SpawnDelay}"
          SortMemberPath="SpawnDelaySeconds"
        />
        <DataGridTextColumn x:DataType="vm:ScenarioAircraftRowViewModel" Header="Airport" Binding="{Binding Airport}" SortMemberPath="Airport" />
        <DataGridTextColumn x:DataType="vm:ScenarioAircraftRowViewModel" Header="Start" Binding="{Binding Start}" SortMemberPath="Start" />
        <DataGridTextColumn x:DataType="vm:ScenarioAircraftRowViewModel" Header="Route" Binding="{Binding Route}" SortMemberPath="Route" />
        <DataGridTextColumn x:DataType="vm:ScenarioAircraftRowViewModel" Header="Presets" Binding="{Binding Presets}" SortMemberPath="PresetCount" />
        <DataGridTextColumn
          x:DataType="vm:ScenarioAircraftRowViewModel"
          Header="Auto-track"
          Binding="{Binding AutoTrack}"
          SortMemberPath="AutoTrack"
        />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
