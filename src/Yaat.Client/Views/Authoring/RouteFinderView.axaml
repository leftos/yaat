<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Yaat.Client.ViewModels.Authoring"
  xmlns:local="using:Yaat.Client.Views.Authoring"
  x:Class="Yaat.Client.Views.Authoring.RouteFinderView"
  x:DataType="vm:RouteFinderViewModel"
  Width="560"
>
  <UserControl.Styles>
    <Style Selector="TextBlock.ql">
      <Setter Property="Foreground" Value="#B0B0B0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style Selector="TextBlock.cap">
      <Setter Property="Foreground" Value="#8A8A8A" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.note">
      <Setter Property="Foreground" Value="#B0B0B0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.head">
      <Setter Property="Foreground" Value="#B0B0B0" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.pill">
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.pill TextBlock">
      <Setter Property="FontSize" Value="10" />
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="#2F6FB0" />
      <Setter Property="BorderBrush" Value="#3F86CC" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#7FB4E6" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Padding" Value="7,4" />
    </Style>
    <Style Selector="Button.flat">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#B0B0B0" />
      <Setter Property="Padding" Value="4,0" />
    </Style>
  </UserControl.Styles>
  <StackPanel Margin="4" Spacing="6">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Path
          Width="16"
          Height="16"
          VerticalAlignment="Center"
          Stroke="#FFFFFF"
          StrokeThickness="1.5"
          StrokeLineCap="Round"
          Data="M 11.2,7 A 4.2,4.2 0 1 1 2.8,7 A 4.2,4.2 0 1 1 11.2,7 M 10.2,10.2 L 13.8,13.8"
        />
        <TextBlock x:Name="TitleText" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Title}" />
      </StackPanel>
      <Button x:Name="CloseButton" Grid.Column="1" Classes="flat" Content="✕" Command="{Binding CancelCommand}" />
    </Grid>
    <DockPanel>
      <Button x:Name="SearchButton" Margin="6,16,0,0" VerticalAlignment="Bottom" DockPanel.Dock="Right" Command="{Binding SearchCommand}">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Path
            Width="16"
            Height="16"
            VerticalAlignment="Center"
            Stroke="#DDDDDD"
            StrokeThickness="1.5"
            StrokeLineCap="Round"
            Data="M 11.2,7 A 4.2,4.2 0 1 1 2.8,7 A 4.2,4.2 0 1 1 11.2,7 M 10.2,10.2 L 13.8,13.8"
          />
          <TextBlock VerticalAlignment="Center" Text="Search" />
        </StackPanel>
      </Button>
      <WrapPanel>
        <StackPanel Margin="0,0,6,0">
          <TextBlock Classes="ql" Text="From" />
          <TextBox x:Name="FromBox" Width="64" IsReadOnly="True" Focusable="False" Text="{Binding DepartureText, Mode=OneWay}" />
        </StackPanel>
        <TextBlock Margin="0,22,6,0" Foreground="#8A8A8A" Text="→" />
        <StackPanel Margin="0,0,12,0">
          <TextBlock Classes="ql" Text="To" />
          <TextBox x:Name="ToBox" Width="64" IsReadOnly="True" Focusable="False" Text="{Binding DestinationText, Mode=OneWay}" />
        </StackPanel>
        <StackPanel Margin="0,0,6,0">
          <TextBlock Classes="ql" Text="Runway" />
          <TextBox x:Name="RunwayBox" Width="56" Text="{Binding RunwayInput}" />
        </StackPanel>
        <StackPanel Margin="0,0,6,0">
          <TextBlock Classes="ql" Text="Suffix" />
          <TextBox x:Name="SuffixBox" Width="50" Text="{Binding SuffixInput}" />
        </StackPanel>
        <StackPanel Margin="0,0,6,0">
          <TextBlock Classes="ql" Text="Airline" />
          <TextBox x:Name="AirlineBox" Width="60" Text="{Binding AirlineInput}" />
        </StackPanel>
        <StackPanel Margin="0,0,6,0">
          <TextBlock Classes="ql" Text="Type" />
          <TextBox x:Name="QueryTypeBox" Width="64" Text="{Binding TypeInput}" />
        </StackPanel>
      </WrapPanel>
    </DockPanel>
    <TextBlock x:Name="QueryCaptionText" Classes="cap" Text="{Binding QueryCaption}" />
    <WrapPanel>
      <TextBlock Margin="0,0,4,0" VerticalAlignment="Center" Classes="cap" Text="Sources" />
      <ItemsControl x:Name="SourcePillList" ItemsSource="{Binding SourcePills}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:RouteSourcePill">
            <Border
              Margin="0,0,4,0"
              Classes="pill"
              Background="{Binding Converter={x:Static local:RouteSourceBrushes.Background}}"
              BorderBrush="{Binding Converter={x:Static local:RouteSourceBrushes.Border}}"
            >
              <TextBlock Foreground="{Binding Converter={x:Static local:RouteSourceBrushes.Foreground}}" Text="{Binding Text}" />
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </WrapPanel>
    <ItemsControl x:Name="FailureList" ItemsSource="{Binding Failures}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="x:String">
          <Border Margin="0,2,0,0" Padding="7,3" Background="#3A2020" BorderBrush="#6A3030" BorderThickness="1" CornerRadius="3">
            <Grid ColumnDefinitions="Auto,*">
              <Path
                Width="16"
                Height="16"
                VerticalAlignment="Center"
                Stroke="#FF9A9A"
                StrokeThickness="1.5"
                StrokeLineCap="Round"
                Data="M 4.5,4.5 L 11.5,11.5 M 11.5,4.5 L 4.5,11.5"
              />
              <TextBlock Grid.Column="1" Margin="6,0,0,0" FontSize="11" Foreground="#FFB0B0" TextWrapping="Wrap" Text="{Binding}" />
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock x:Name="SearchingText" Classes="ql" Text="Searching…" IsVisible="{Binding IsSearching}" />
    <Border BorderBrush="#3D3D3D" BorderThickness="1" CornerRadius="3">
      <StackPanel>
        <Border Padding="7,3" Background="#2A2A2A" BorderBrush="#3D3D3D" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="*,136,38">
            <TextBlock Classes="head" Text="Route" />
            <TextBlock Grid.Column="1" Classes="head" Text="Sources" />
            <TextBlock Grid.Column="2" HorizontalAlignment="Right" Classes="head" Text="Filed" />
          </Grid>
        </Border>
        <ListBox x:Name="RouteList" MaxHeight="300" Background="Transparent" ItemsSource="{Binding Routes}" SelectedItem="{Binding SelectedRoute}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:RouteFinderRowViewModel">
              <Grid ColumnDefinitions="*,136,38">
                <StackPanel>
                  <TextBlock FontFamily="Consolas, Menlo, monospace" FontSize="11.5" TextWrapping="Wrap" Text="{Binding RouteText}" />
                  <TextBlock Classes="note" Text="{Binding NoteText}" IsVisible="{Binding HasNotes}" />
                </StackPanel>
                <ItemsControl Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Top" ItemsSource="{Binding Sources}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <Border
                        Margin="0,0,3,2"
                        Classes="pill"
                        Background="{Binding Converter={x:Static local:RouteSourceBrushes.Background}}"
                        BorderBrush="{Binding Converter={x:Static local:RouteSourceBrushes.Border}}"
                      >
                        <TextBlock Foreground="{Binding Converter={x:Static local:RouteSourceBrushes.Foreground}}" Text="{Binding}" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Top" Text="{Binding CountText}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Button
          x:Name="ShowAllNavdataButton"
          Classes="link"
          Content="{Binding ShowAllNavdataText}"
          Command="{Binding ShowAllNavdataRoutesCommand}"
          IsVisible="{Binding HasHiddenNavdata}"
          ToolTip.Tip="Show all navdata routes"
        />
      </StackPanel>
    </Border>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock VerticalAlignment="Center" Classes="ql" Text="Cruise altitude (ft)" />
      <TextBlock x:Name="CruisePreviewText" VerticalAlignment="Center" Text="{Binding CruisePreview}" />
    </StackPanel>
    <TextBlock
      x:Name="CruiseCaptionText"
      Classes="cap"
      Text="{Binding CruiseCaption}"
      IsVisible="{Binding CruiseCaption, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
    />
    <CheckBox
      x:Name="RealCallsignBox"
      Content="{Binding RealCallsignText}"
      IsChecked="{Binding UseRealCallsignAndType}"
      IsVisible="{Binding CanUseRealCallsignAndType}"
    />
    <StackPanel Orientation="Horizontal" Spacing="6">
      <Button x:Name="ApplyButton" Classes="accent" Content="Apply" Command="{Binding ApplyCommand}" />
      <Button x:Name="CancelButton" Content="Cancel" Command="{Binding CancelCommand}" />
      <TextBlock VerticalAlignment="Center" Classes="cap" Text="Closes on Apply, Esc or a click outside." />
    </StackPanel>
  </StackPanel>
</UserControl>
