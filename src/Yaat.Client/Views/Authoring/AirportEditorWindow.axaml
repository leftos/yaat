<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Yaat.Client.ViewModels.Authoring"
  xmlns:local="using:Yaat.Client.Views.Authoring"
  x:Class="Yaat.Client.Views.Authoring.AirportEditorWindow"
  x:DataType="vm:AirportEditorViewModel"
  Icon="avares://Yaat.Client/Resources/icon.png"
  Title="Airport Editor"
  Background="#1F1F1F"
  Width="1100"
  Height="700"
  MinWidth="700"
  MinHeight="450"
  CanResize="True"
>
  <Window.Styles>
    <Style Selector="Border.vsep">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Margin" Value="4,0" />
      <Setter Property="Background" Value="#3D3D3D" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.toolbar Button">
      <Setter Property="Padding" Value="9,3" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.toolbar :is(Button)">
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style Selector="TextBlock.status">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#B0B0B0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Path.icon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="StrokeThickness" Value="1.4" />
    </Style>
  </Window.Styles>
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="toolbar" Background="#242424" BorderBrush="#3D3D3D" BorderThickness="0,0,0,1" Padding="8,5" MinHeight="36">
      <StackPanel Orientation="Horizontal" Spacing="5">
        <Button x:Name="OpenFromCacheButton" Content="Open from vNAS cache…" Command="{Binding OpenFromCacheCommand}" />
        <Button x:Name="OpenFileButton" Content="Open file…" Command="{Binding OpenFileCommand}" />
        <Button x:Name="OpenFolderButton" Content="Open folder…" Command="{Binding OpenFolderCommand}" />
        <ToggleButton
          x:Name="ImageryToggle"
          Content="Imagery"
          IsChecked="{Binding ShowImagery}"
          ToolTip.Tip="Show the airport's vNAS tower-cab image under the map"
        />
        <Border Classes="vsep" />
        <Button x:Name="UndoButton" Command="{Binding UndoCommand}" ToolTip.Tip="{Binding UndoDescription}">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Viewbox Width="13" Height="13">
              <Path
                Classes="icon"
                Data="M5.5,3.5 L2.5,6.5 L5.5,9.5 M2.5,6.5 H10 A3.5,3.5 0 0 1 10,13.5 H7"
                Stroke="{Binding $parent[Button].Foreground}"
              />
            </Viewbox>
            <TextBlock Text="Undo" />
          </StackPanel>
        </Button>
        <Button x:Name="RedoButton" Command="{Binding RedoCommand}" ToolTip.Tip="{Binding RedoDescription}">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Viewbox Width="13" Height="13">
              <Path
                Classes="icon"
                Data="M10.5,3.5 L13.5,6.5 L10.5,9.5 M13.5,6.5 H6 A3.5,3.5 0 0 0 6,13.5 H9"
                Stroke="{Binding $parent[Button].Foreground}"
              />
            </Viewbox>
            <TextBlock Text="Redo" />
          </StackPanel>
        </Button>
        <Button
          x:Name="DeleteButton"
          Content="Delete"
          Command="{Binding DeleteSelectedCommand}"
          ToolTip.Tip="Delete the selected vertex, or the selected feature (Del)"
        />
        <Border Classes="vsep" />
        <ToggleButton x:Name="SelectModeButton" Content="Select" ToolTip.Tip="Select features and drag vertices and points (Esc)" />
        <ToggleButton
          x:Name="TaxiwayModeButton"
          Content="Taxiway"
          ToolTip.Tip="Draw a taxiway: click each vertex, then double-click the last one or press Enter (T)"
        />
        <ToggleButton x:Name="RunwayModeButton" Content="Runway" ToolTip.Tip="Draw a runway: click one end, then the other (R)" />
        <ToggleButton x:Name="ParkingModeButton" Content="Parking" ToolTip.Tip="Place a parking position with a click (P)" />
        <ToggleButton x:Name="SpotModeButton" Content="Spot" ToolTip.Tip="Place a spot with a click (S)" />
        <ToggleButton x:Name="HelipadModeButton" Content="Helipad" ToolTip.Tip="Place a helipad with a click (H)" />
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="#242424" BorderBrush="#3D3D3D" BorderThickness="0,1,0,0" Padding="10,4" MinHeight="24">
      <TextBlock x:Name="StatusText" Classes="status" Text="{Binding StatusText}" />
    </Border>
    <Border x:Name="PropertyPanel" DockPanel.Dock="Right" Width="300" Background="#242424" BorderBrush="#3D3D3D" BorderThickness="1,0,0,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Properties" FontWeight="SemiBold" Foreground="#E0E0E0" Margin="10,8,10,6" />
        <Panel>
          <TextBlock
            x:Name="NoSelectionText"
            Classes="status"
            Text="No feature selected."
            VerticalAlignment="Top"
            Margin="10,2,10,0"
            IsVisible="{Binding SelectedFeature, Converter={x:Static ObjectConverters.IsNull}}"
          />
          <ScrollViewer IsVisible="{Binding SelectedFeature, Converter={x:Static ObjectConverters.IsNotNull}}">
            <ItemsControl x:Name="PropertyRows" ItemsSource="{Binding SelectionRows}" Margin="10,0,10,8">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AirportEditorPropertyRow">
                  <Grid ColumnDefinitions="96,*" Margin="0,1">
                    <TextBlock
                      Text="{Binding Name}"
                      FontSize="11"
                      Foreground="#B0B0B0"
                      VerticalAlignment="Top"
                      Margin="0,4,6,0"
                      TextTrimming="CharacterEllipsis"
                    />
                    <TextBox
                      Grid.Column="1"
                      Text="{Binding Value, Mode=OneWay}"
                      IsReadOnly="True"
                      BorderThickness="0"
                      Background="Transparent"
                      TextWrapping="Wrap"
                      FontSize="11"
                      Padding="2"
                      MinHeight="0"
                    />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Panel>
      </DockPanel>
    </Border>
    <local:AirportEditorCanvas x:Name="MapCanvas" />
  </DockPanel>
</Window>
