<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Yaat.Client.ViewModels.Authoring"
  xmlns:local="using:Yaat.Client.Views.Authoring"
  x:Class="Yaat.Client.Views.Authoring.ScenarioBrowserView"
  x:DataType="vm:ScenarioBrowserViewModel"
  Background="#262626"
>
  <UserControl.Styles>
    <Style Selector="Border.count">
      <Setter Property="Background" Value="#3A3A3A" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.count > TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Foreground" Value="#8A8A8A" />
    </Style>
    <Style Selector="StackPanel.empty">
      <Setter Property="Margin" Value="14,18" />
      <Setter Property="Spacing" Value="6" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.empty > TextBlock">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="#DDDDDD" />
    </Style>
    <Style Selector="StackPanel.empty > TextBlock.sub">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#B0B0B0" />
    </Style>
    <Style Selector="ListBox.rows > ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="24" />
    </Style>
  </UserControl.Styles>
  <UserControl.Resources>
    <DataTemplate x:Key="RowTemplate" x:DataType="vm:ScenarioBrowserRowViewModel">
      <Grid
        ColumnDefinitions="*,Auto"
        ColumnSpacing="6"
        Background="{Binding IsCorrupt, Converter={x:Static local:ScenarioBrowserView.RowBackground}}"
      >
        <StackPanel Grid.Column="0" Margin="8,4">
          <TextBlock
            Text="{Binding Name}"
            TextTrimming="CharacterEllipsis"
            Foreground="{Binding Converter={x:Static local:ScenarioBrowserView.NameBrush}}"
          />
          <TextBlock Text="{Binding Id}" FontSize="10" Foreground="#8F8F8F" FontFamily="Cascadia Mono,Consolas,monospace" Margin="0,1,0,0" />
        </StackPanel>
        <ItemsControl
          Grid.Column="1"
          Margin="0,0,8,0"
          VerticalAlignment="Center"
          ItemsSource="{Binding Converter={x:Static local:ScenarioBrowserView.BadgeLooks}}"
        >
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="3" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:ScenarioBadgeLook">
              <Border Background="Transparent" ToolTip.Tip="{Binding Tip}">
                <Viewbox Width="14" Height="14">
                  <Path Width="16" Height="16" Data="{Binding Icon}" Stroke="{Binding Stroke}" Fill="{Binding Fill}" StrokeThickness="1.4" />
                </Viewbox>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>
  <TabControl x:Name="BrowserTabs" Padding="0" SelectedIndex="{Binding SelectedTab, Converter={x:Static local:ScenarioBrowserView.TabIndexOf}}">
    <TabControl.ContextMenu>
      <ContextMenu>
        <MenuItem x:Name="NewMenuItem" Header="New scenario" Command="{Binding NewCommand}" />
        <MenuItem x:Name="DuplicateMenuItem" Header="Duplicate" Command="{Binding DuplicateCommand}" />
        <MenuItem x:Name="DeleteMenuItem" Header="Delete…" Command="{Binding DeleteCommand}" />
        <Separator />
        <MenuItem x:Name="ImportMenuItem" Header="Import…" Command="{Binding ImportCommand}" />
        <MenuItem x:Name="SaveCopyMenuItem" Header="Save a copy…" Command="{Binding SaveCopyCommand}" />
        <MenuItem x:Name="ExportJsonMenuItem" Header="Export JSON…" Command="{Binding ExportJsonCommand}" />
        <MenuItem x:Name="ExportCleanJsonMenuItem" Header="Export clean JSON…" Command="{Binding ExportCleanJsonCommand}" />
        <MenuItem x:Name="ExportAllUnexportedMenuItem" Header="Export all unexported…" Command="{Binding ExportAllUnexportedCommand}" />
        <MenuItem x:Name="TestInRoomMenuItem" Header="Test in Room" Command="{Binding TestInRoomCommand}" />
        <Separator />
        <MenuItem x:Name="RefreshMenuItem" Header="Refresh" Command="{Binding RefreshCommand}" />
        <MenuItem x:Name="ResolveServerChangesMenuItem" Header="Merge server changes…" Command="{Binding ResolveServerChangesCommand}" />
        <MenuItem x:Name="CompareMenuItem" Header="Compare with…" Command="{Binding CompareCommand}" />
      </ContextMenu>
    </TabControl.ContextMenu>
    <TabItem x:Name="LocalTab">
      <TabItem.Header>
        <StackPanel Orientation="Horizontal" Spacing="5">
          <TextBlock Text="Local" VerticalAlignment="Center" />
          <Border Classes="count">
            <TextBlock Text="{Binding LocalRows.Count}" />
          </Border>
        </StackPanel>
      </TabItem.Header>
      <Panel>
        <ListBox
          x:Name="LocalList"
          Classes="rows"
          Background="Transparent"
          ItemsSource="{Binding LocalRows}"
          SelectedItem="{Binding SelectedLocalRow}"
          ItemTemplate="{StaticResource RowTemplate}"
        />
        <StackPanel Classes="empty">
          <StackPanel.IsVisible>
            <MultiBinding Converter="{x:Static local:ScenarioBrowserView.EmptyListVisible}">
              <Binding Path="HasArtcc" />
              <Binding Path="LocalRows.Count" />
            </MultiBinding>
          </StackPanel.IsVisible>
          <TextBlock Text="No local copies yet." />
          <TextBlock Classes="sub" Text="Use New or Import to add one." />
        </StackPanel>
        <StackPanel Classes="empty" IsVisible="{Binding !HasArtcc}">
          <TextBlock Text="Set your ARTCC in Settings to list scenarios." />
        </StackPanel>
      </Panel>
    </TabItem>
    <TabItem x:Name="ServerTab">
      <TabItem.Header>
        <StackPanel Orientation="Horizontal" Spacing="5">
          <TextBlock Text="Server" VerticalAlignment="Center" />
          <Border Classes="count">
            <TextBlock Text="{Binding ServerRows.Count}" />
          </Border>
        </StackPanel>
      </TabItem.Header>
      <Panel>
        <ListBox
          x:Name="ServerList"
          Classes="rows"
          Background="Transparent"
          ItemsSource="{Binding ServerRows}"
          SelectedItem="{Binding SelectedServerRow}"
          ItemTemplate="{StaticResource RowTemplate}"
        />
        <StackPanel Classes="empty">
          <StackPanel.IsVisible>
            <MultiBinding Converter="{x:Static local:ScenarioBrowserView.EmptyListVisible}">
              <Binding Path="HasArtcc" />
              <Binding Path="ServerRows.Count" />
            </MultiBinding>
          </StackPanel.IsVisible>
          <TextBlock Text="{Binding ArtccLabelText, StringFormat='No downloaded scenarios for {0}.'}" />
          <TextBlock Classes="sub" Text="Connect to the internet and press Refresh." />
        </StackPanel>
        <StackPanel Classes="empty" IsVisible="{Binding !HasArtcc}">
          <TextBlock Text="Set your ARTCC in Settings to list scenarios." />
        </StackPanel>
      </Panel>
    </TabItem>
  </TabControl>
</UserControl>
