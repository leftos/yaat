<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:Class="Yaat.Client.Views.Authoring.ImportConflictDialog"
  Icon="avares://Yaat.Client/Resources/icon.png"
  Title="Import scenarios"
  Background="#1F1F1F"
  Width="480"
  SizeToContent="Height"
  CanResize="False"
  WindowStartupLocation="CenterOwner"
>
  <StackPanel Margin="18,14,18,16">
    <TextBlock Text="This id is already in use" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,6" />
    <TextBlock x:Name="FileText" FontSize="11" Foreground="#B0B0B0" Margin="0,0,0,8" />
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,10" />
    <StackPanel Spacing="2" Margin="18,0,0,12">
      <TextBlock x:Name="NewIdText" TextWrapping="Wrap" Foreground="#D4D4D4" />
      <TextBlock x:Name="KeepIdText" TextWrapping="Wrap" Foreground="#D4D4D4" />
      <TextBlock x:Name="SkipText" TextWrapping="Wrap" Foreground="#D4D4D4" />
    </StackPanel>
    <CheckBox x:Name="ApplyToRemainingCheckBox" IsChecked="True" Margin="0,0,0,14" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button x:Name="NewIdButton" Content="New id" MinWidth="74" IsDefault="True" Classes="accent" />
      <Button x:Name="KeepIdButton" Content="Keep id" MinWidth="74" />
      <Button x:Name="SkipButton" Content="Skip" MinWidth="74" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
