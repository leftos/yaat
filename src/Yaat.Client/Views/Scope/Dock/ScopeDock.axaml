<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:dock="using:Yaat.Client.Views.Scope.Dock"
  xmlns:vm="using:Yaat.Client.ViewModels"
  x:Class="Yaat.Client.Views.Scope.Dock.ScopeDock"
  x:DataType="vm:ScopeViewModel"
>
  <Border Background="#070b0f" BorderBrush="#22313b" BorderThickness="1,0,0,0">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding DockViews}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ScopeDockViewModel">
            <dock:ScopeViewCard Margin="6,6,6,0" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Border>
</UserControl>
