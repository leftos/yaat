<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:scope="using:Yaat.Client.Views.Scope"
  xmlns:dock="using:Yaat.Client.Views.Scope.Dock"
  xmlns:toolbar="using:Yaat.Client.Views.Scope.Toolbar"
  xmlns:vm="using:Yaat.Client.ViewModels"
  x:Class="Yaat.Client.Views.Scope.ScopeWindow"
  x:DataType="vm:ScopeViewModel"
  Icon="avares://Yaat.Client/Resources/icon.png"
  Title="YAAT Scope"
>
  <!-- The bar takes a fixed 45 px row; an open menu's tray hangs below it over the scope, so it never resizes the scope.
       The views dock is a 360 px column right of the scope, collapsed while no open view is docked. -->
  <Grid RowDefinitions="45,*" ColumnDefinitions="*,Auto">
    <scope:ScopeView x:Name="View" Grid.Row="1" Grid.Column="0" />
    <dock:ScopeDock Grid.Row="1" Grid.Column="1" Width="360" IsVisible="{Binding HasDockedViews}" />
    <toolbar:ScopeToolbar Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="2" VerticalAlignment="Top" ZIndex="1" />
  </Grid>
</Window>
