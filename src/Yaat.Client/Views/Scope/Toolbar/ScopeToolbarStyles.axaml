<!-- The Scope toolbar's tile look, shared by the bar, its tray and the buttons torn off onto the scope. -->
<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- A tile fills its control: no margin, text centred, padding 6 left and 9 right with the 1 DIP active ring inside it. -->
  <Style Selector="Button.scopeButton">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="5,0,8,0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="#10181e" />
    <Setter Property="BorderBrush" Value="#10181e" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="#c9d4dc" />
  </Style>
  <Style Selector="Button.scopeButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#10181e" />
    <Setter Property="BorderBrush" Value="#10181e" />
    <Setter Property="Foreground" Value="#c9d4dc" />
  </Style>
  <Style Selector="Button.scopeButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#10181e" />
  </Style>
  <Style Selector="Button.scopeButton.active /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="#58c4e6" />
    <Setter Property="Foreground" Value="#e7f6fb" />
  </Style>
  <!-- A menu's mark in the tile's top-right corner. -->
  <Style Selector="TextBlock.scopeMenuMark">
    <Setter Property="FontSize" Value="9" />
    <Setter Property="LineHeight" Value="11" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="0,1,2,0" />
    <Setter Property="Foreground" Value="#8fa3b1" />
  </Style>
  <Style Selector="TextBlock.scopeMenuMark.active">
    <Setter Property="Foreground" Value="#58c4e6" />
  </Style>
  <!-- The tear-off pick strip over a tile's left edge, the tile's full height: gold under the pointer. -->
  <Style Selector="Border.scopeStrip">
    <Setter Property="Width" Value="4" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.scopeStrip:pointerover">
    <Setter Property="Background" Value="#E0B84A" />
  </Style>
  <!-- A torn-off copy's accent bar, always drawn. -->
  <Style Selector="Border.scopeStrip.accent">
    <Setter Property="Background" Value="#E0B84A" />
  </Style>
  <!-- A tear-off marked for DEL TEAROFF. -->
  <Style Selector="Border.scopeMark">
    <Setter Property="BorderBrush" Value="#E05050" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
</Styles>
