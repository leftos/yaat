<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:dcb="using:Yaat.Client.Views.Scope.Toolbar.Dcb"
  x:Class="Yaat.Client.Views.Scope.Toolbar.ScopeToolbar"
  FontFamily="{StaticResource MonoFont}"
  FontSize="12"
>
  <UserControl.Styles>
    <StyleInclude Source="avares://Yaat.Client/Views/Scope/Toolbar/ScopeToolbarStyles.axaml" />
  </UserControl.Styles>
  <StackPanel>
    <!-- The bar scrolls sideways while it is wider than the window; the chevrons show only then. -->
    <Border Height="45" Background="#0a1015">
      <Grid x:Name="BarRow" ColumnDefinitions="Auto,*,Auto">
        <Button
          x:Name="ScrollLeft"
          Grid.Column="0"
          Classes="scopeButton"
          Padding="6,0"
          Content="‹"
          Focusable="False"
          IsVisible="False"
          Click="OnScrollLeftClick"
        />
        <!-- A focused tile is brought into view only when the keyboard focused it, so a press on a part-hidden tile never
             moves the bar under the pointer. -->
        <dcb:KeyIgnoringScrollViewer
          x:Name="MainScroll"
          Grid.Column="1"
          HorizontalScrollBarVisibility="Hidden"
          VerticalScrollBarVisibility="Disabled"
          BringIntoViewOnFocusChange="False"
        >
          <!-- The 1 DIP spacing over the row's background draws the dividers between tiles. -->
          <StackPanel x:Name="MainRow" Background="#22313b" Orientation="Horizontal" Spacing="1" HorizontalAlignment="Left" />
        </dcb:KeyIgnoringScrollViewer>
        <Button
          x:Name="ScrollRight"
          Grid.Column="2"
          Classes="scopeButton"
          Padding="6,0"
          Content="›"
          Focusable="False"
          IsVisible="False"
          Click="OnScrollRightClick"
        />
      </Grid>
    </Border>
    <!-- The tray: columns of two half-height tiles, wrapped into further two-row blocks when they don't fit the window. Each
         column draws its own dividers, so the tray's background shows beside a block narrower than the first. -->
    <Border x:Name="Tray" Background="#0a1015" BorderBrush="#22313b" BorderThickness="0,0,0,1" IsVisible="False">
      <WrapPanel x:Name="TrayRow" Orientation="Horizontal" LineSpacing="1" HorizontalAlignment="Left" />
    </Border>
  </StackPanel>
</UserControl>
