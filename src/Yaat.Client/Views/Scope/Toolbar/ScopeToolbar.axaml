<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:Class="Yaat.Client.Views.Scope.Toolbar.ScopeToolbar"
  FontFamily="{StaticResource MonoFont}"
  FontSize="12"
>
  <UserControl.Styles>
    <StyleInclude Source="avares://Yaat.Client/Views/Scope/Toolbar/ScopeToolbarStyles.axaml" />
    <Style Selector="WrapPanel#TrayRow Button.scopeButton">
      <Setter Property="Margin" Value="2,4" />
    </Style>
  </UserControl.Styles>
  <StackPanel>
    <Border Height="45" Background="#0a1015" Padding="6,0">
      <StackPanel x:Name="MainRow" Orientation="Horizontal" VerticalAlignment="Center" />
    </Border>
    <!-- The tray wraps onto more rows when its buttons don't fit; one row keeps the bar's height. -->
    <Border x:Name="Tray" MinHeight="45" Background="#0a1015" BorderBrush="#22313b" BorderThickness="0,1,0,0" Padding="6,0" IsVisible="False">
      <WrapPanel x:Name="TrayRow" Orientation="Horizontal" VerticalAlignment="Center" />
    </Border>
  </StackPanel>
</UserControl>
