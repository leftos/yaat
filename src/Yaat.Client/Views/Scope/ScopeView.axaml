<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:scope="using:Yaat.Client.Views.Scope"
  xmlns:vm="using:Yaat.Client.ViewModels"
  x:Class="Yaat.Client.Views.Scope.ScopeView"
  x:DataType="vm:ScopeViewModel"
  Background="Black"
>
  <UserControl.Styles>
    <StyleInclude Source="avares://Yaat.Client/Views/Scope/Toolbar/ScopeToolbarStyles.axaml" />
  </UserControl.Styles>
  <Grid>
    <scope:ScopeCanvas
      x:Name="Canvas"
      Aircraft="{Binding Aircraft}"
      SelectedAircraft="{Binding SelectedAircraft}"
      CenterLat="{Binding CenterLat, Mode=TwoWay}"
      CenterLon="{Binding CenterLon, Mode=TwoWay}"
      RangeNm="{Binding RangeNm, Mode=TwoWay}"
      ShowMvaAltitudeTint="{Binding ShowMvaHints}"
      MvaFacilityId="{Binding Main.Radar.MvaFacilityId}"
      TemplateId="{Binding TemplateId}"
      Viewer="{Binding Viewer}"
      Brightness="{Binding Brightness}"
      DbSettings="{Binding DbSettings}"
      OthersLevel="{Binding EffectiveBand.OthersLevel}"
      VectorMinutes="{Binding EffectiveBand.VectorMin}"
      VectorOwnership="{Binding VectorOwnership}"
      HistoryCount="{Binding EffectiveBand.History}"
    />
    <!-- No background: its empty area passes clicks to the canvas; only its tear-offs are hit. -->
    <scope:ScopeTearoffLayer x:Name="TearoffLayer" TextElement.FontFamily="{StaticResource MonoFont}" TextElement.FontSize="12" />
  </Grid>
</UserControl>
