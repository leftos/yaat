<Window
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:Yaat.Client.ViewModels"
  xmlns:settings="using:Yaat.Client.Views.Settings"
  x:Class="Yaat.Client.Views.SettingsWindow"
  x:DataType="vm:SettingsViewModel"
  Icon="avares://Yaat.Client/Resources/icon.png"
  Title="Settings"
  MinWidth="880"
  MinHeight="600"
>
  <Window.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#1E293B" />
      <Setter Property="BorderBrush" Value="#334155" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="Button.section-link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0,2" />
      <Setter Property="Margin" Value="0,0,20,0" />
      <Setter Property="Foreground" Value="#60A5FA" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.section-link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#93C5FD" />
    </Style>
    <Style Selector="ListBox#SectionNav ListBoxItem">
      <Setter Property="Padding" Value="12,6" />
    </Style>
    <Style Selector="ListBox#SectionNav ListBoxItem.group-header">
      <Setter Property="Padding" Value="12,12,12,2" />
    </Style>
    <Style Selector="TextBlock.nav-group">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
    </Style>
  </Window.Styles>

  <Design.DataContext>
    <vm:SettingsViewModel />
  </Design.DataContext>

  <DockPanel>
    <!-- Footer -->
    <Border DockPanel.Dock="Bottom" BorderBrush="#334155" BorderThickness="0,1,0,0" Padding="12">
      <DockPanel>
        <Button
          Content="Reset section"
          x:Name="ResetSectionButton"
          DockPanel.Dock="Left"
          Command="{Binding ResetSectionCommand}"
          ToolTip.Tip="{Binding ResetSectionToolTip}"
          ToolTip.ShowOnDisabled="True"
        />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
          <Button Content="OK" x:Name="OkButton" Width="80" IsDefault="True" />
          <Button Content="Apply" x:Name="ApplyButton" Width="80" />
          <Button Content="Cancel" x:Name="CancelButton" Width="80" IsCancel="True" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Sidebar: group headers and the sections under them -->
    <Border DockPanel.Dock="Left" Width="232" BorderBrush="#334155" BorderThickness="0,0,1,0">
      <ListBox x:Name="SectionNav" ItemsSource="{x:Static settings:SettingsNavigation.Items}" Background="Transparent" Margin="0,8">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="settings:SettingsNavItem">
            <Panel>
              <TextBlock Text="{Binding Title}" IsVisible="{Binding !IsHeader}" FontSize="{DynamicResource UiFontSize}" />
              <TextBlock Text="{Binding Title}" IsVisible="{Binding IsHeader}" Classes="nav-group" />
            </Panel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <!-- The selected section -->
    <DockPanel>
      <TextBlock x:Name="SectionTitle" DockPanel.Dock="Top" FontSize="18" FontWeight="SemiBold" Margin="16,12,16,4" />
      <ContentControl x:Name="SectionHost" />
    </DockPanel>
  </DockPanel>
</Window>
