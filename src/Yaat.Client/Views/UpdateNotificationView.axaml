<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Yaat.Client.ViewModels"
             x:Class="Yaat.Client.Views.UpdateNotificationView"
             x:DataType="vm:MainViewModel">
  <StackPanel>
    <!-- Server-requested update: the connected server recommends a newer client than this build.
         Hidden while the Velopack banner below is up, since that one can actually install. -->
    <Border Background="#3A3418"
            BorderBrush="#5C5426"
            BorderThickness="0,1,0,0"
            Padding="8,4"
            IsVisible="{Binding ShowServerUpdateNotice}">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Grid.Column="0"
                   VerticalAlignment="Center"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Text="{Binding ServerUpdateNotice}" />
        <Button Grid.Column="1"
                Content="Check for Update"
                FontSize="11"
                Padding="8,2"
                Margin="4,0"
                Command="{Binding CheckForUpdateCommand}" />
        <Button Grid.Column="2"
                Content="Dismiss"
                FontSize="11"
                Padding="8,2"
                Margin="4,0"
                Command="{Binding DismissServerUpdateNoticeCommand}" />
      </Grid>
    </Border>

    <Border Background="#1A3A5C"
            BorderBrush="#2A5A8C"
            BorderThickness="0,1,0,0"
            Padding="8,4"
            IsVisible="{Binding IsUpdateAvailable}">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
            <!-- Status text -->
            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       FontSize="12">
                <TextBlock.Text>
                    <MultiBinding StringFormat="YAAT {0} is available.">
                        <Binding Path="UpdateVersion" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <!-- Progress bar (visible during download) -->
            <ProgressBar Grid.Column="1"
                         Width="120"
                         Height="14"
                         Minimum="0"
                         Maximum="100"
                         Value="{Binding UpdateProgress}"
                         IsVisible="{Binding IsDownloadingUpdate}"
                         VerticalAlignment="Center"
                         Margin="8,0" />

            <!-- Update button -->
            <Button Grid.Column="2"
                    Content="Update Now"
                    FontSize="11"
                    Padding="8,2"
                    Margin="4,0"
                    Command="{Binding UpdateNowCommand}"
                    IsVisible="{Binding !IsDownloadingUpdate}" />

            <!-- Dismiss button -->
            <Button Grid.Column="3"
                    Content="Later"
                    FontSize="11"
                    Padding="8,2"
                    Margin="4,0"
                    Command="{Binding DismissUpdateCommand}"
                    IsVisible="{Binding !IsDownloadingUpdate}" />
        </Grid>
    </Border>
  </StackPanel>
</UserControl>
