{"expect":"deny","cmd":"dotnet build"}
{"expect":"deny","cmd":"dotnet test"}
{"expect":"deny","cmd":"dotnet test 2>&1 | tee .tmp/test.log"}
{"expect":"deny","cmd":"dotnet build -p:TreatWarningsAsErrors=true 2>&1 | tee .tmp/build.log"}
{"expect":"deny","cmd":"timeout 120 dotnet test 2>&1 | tee .tmp/test.log"}
{"expect":"deny","cmd":"dotnet build 2>&1 | tail -n 20"}
{"expect":"deny","cmd":"timeout 120 dotnet test > /dev/null 2>&1"}
{"expect":"deny","cmd":"dotnet run --project src/Yaat.Client"}
{"expect":"deny","cmd":"tools/gate.sh .tmp/test.log dotnet test"}
{"expect":"deny","cmd":"bash tools/gate.sh .tmp/build.log dotnet build -q"}
{"expect":"deny","cmd":"prek run --all-files"}
{"expect":"deny","cmd":"dotnet format"}
{"expect":"deny","cmd":"dotnet format ."}
{"expect":"deny","cmd":"cd X:/dev/yaat && dotnet build"}
{"expect":"allow","cmd":"rg -n 'dotnet build' CLAUDE.md"}
{"expect":"allow","cmd":"rg -n 'localhost:5000|dotnet build  *#' CLAUDE.md"}
{"expect":"allow","cmd":"tools/gate.sh .tmp/build.log dotnet build -p:TreatWarningsAsErrors=true"}
{"expect":"allow","cmd":"bash tools/gate.sh .tmp/test.log timeout 120 dotnet test yaat.slnx"}
{"expect":"allow","cmd":"timeout 30 tools/gate.sh .tmp/test.log dotnet test -- --filter-class \"*X\""}
{"expect":"allow","cmd":"cd X:/dev/yaat-server && ../yaat/tools/gate.sh .tmp/build.log dotnet build"}
{"expect":"allow","cmd":"dotnet build -p:TreatWarningsAsErrors=true > .tmp/build.log 2>&1; rc=$?; tail -n 20 .tmp/build.log; (exit $rc)"}
{"expect":"allow","cmd":"timeout 30 dotnet test -- --filter-class \"*X\" > \"$WT/.tmp/implementer-test.log\" 2>&1; rc=$?; tail -n 15 \"$WT/.tmp/implementer-test.log\"; (exit $rc)"}
{"expect":"allow","cmd":"dotnet run --project tools/CrcWireDump > .tmp/crcwiredump.log 2>&1"}
{"expect":"allow","cmd":"pwsh tools/test-all.ps1"}
{"expect":"allow","cmd":"dotnet format style"}
{"expect":"allow","cmd":"dotnet format analyzers"}
{"expect":"allow","cmd":"prek run"}
{"expect":"allow","cmd":"dotnet workload restore"}
{"expect":"allow","cmd":"cat > f <<'EOF'\ndotnet build\nprek run --all-files\nEOF"}
