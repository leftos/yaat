<Project>
  <PropertyGroup>
    <Version>0.19.1-beta</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!--
      The compiler reports IDE0005 (unused usings) in a build only when it generates the XML
      documentation file. The doc-comment warnings that file brings are suppressed: this repo
      does not require doc comments, and malformed ones are tracked separately. The doc files
      are build-only and never published.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <NoWarn>$(NoWarn);CS1591;CS1573;CS1574;CS0419;CS1734;CS1570;CS1571;CS1572;CS1584;CS1587;CS1658;CS1711;CS1712;CS1580;CS1579;CS1581;CS1589;CS1590;CS1592;CS1710;CS1723;CS1735</NoWarn>
    <!--
      yaat-server's solution build references yaat projects from outside its own .slnx and
      sets this false (its Directory.Build.props), so its projects pass Configuration and
      Platform to their references. yaat's projects must do the same: with the solution
      default (true) a yaat project's references to the same projects strip them, each is
      built twice with different global properties into one obj folder, and the two
      compiles race (CS2012 "being used by another process").
    -->
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
  </PropertyGroup>
</Project>
