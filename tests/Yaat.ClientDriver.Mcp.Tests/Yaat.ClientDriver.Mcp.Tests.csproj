<Project Sdk="Microsoft.NET.Sdk">
  <!-- The MCP server's own tests. net10.0-windows because the server (and so its pipe client) is. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Builds on the Linux CI runner like the server itself; runs only on Windows, where UI Automation exists. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <IsTestProject Condition="!$([MSBuild]::IsOSPlatform('Windows'))">false</IsTestProject>
    <IsTestingPlatformApplication Condition="!$([MSBuild]::IsOSPlatform('Windows'))">false</IsTestingPlatformApplication>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- xUnit v3 test projects are executables (required by Avalonia.Headless.XUnit 12.x). -->
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.0" />
    <PackageReference Include="MartinCostello.Logging.XUnit.v3" Version="0.7.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Yaat.Client\Yaat.Client.csproj" />
    <ProjectReference Include="..\..\src\Yaat.Client.Core\Yaat.Client.Core.csproj" />
    <ProjectReference Include="..\..\src\Yaat.Sim\Yaat.Sim.csproj" />
    <!-- Aliased: the MCP compiles the same automation Protocol source files the client does, so an unaliased
         reference would make every automation type ambiguous (CS0433). A test that needs MCP types says
         `extern alias mcp;` and reaches them as `mcp::Yaat.ClientDriver.Mcp.…`. -->
    <ProjectReference Include="..\..\tools\Yaat.ClientDriver.Mcp\Yaat.ClientDriver.Mcp.csproj" Aliases="mcp" />
  </ItemGroup>

  <ItemGroup>
    <!-- The pipe fixture, the pipe client and the per-run app-data redirect are shared with Yaat.Client.UI.Tests. -->
    <Compile Include="..\Yaat.Client.UI.Tests\Helpers\AutomationHostFixture.cs" Link="Helpers\AutomationHostFixture.cs" />
    <Compile Include="..\Yaat.Client.UI.Tests\Helpers\AutomationPipeTestClient.cs" Link="Helpers\AutomationPipeTestClient.cs" />
    <Compile Include="..\Yaat.Client.UI.Tests\ModuleInit.cs" Link="ModuleInit.cs" />
    <!-- xunit.runner.json must be next to the test DLL or xUnit ignores it. -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- A real PNG a scripted pipe host answers screenshot with: headless drawing encodes none a decoder reads. -->
    <None Include="TestData\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
